{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal",
  "version": "0.1.0",
  "identifier": "de.journal.local",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Journal", "width": 1180, "height": 780, "minWidth": 720, "minHeight": 520, "decorations": false, "dragDropEnabled": false, "theme": "Dark", "backgroundColor": "#000000", "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https:; style-src-attr 'unsafe-inline'; font-src 'self' data: https:; img-src 'self' data: blob: https:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "windows": { "nsis": { "languages": ["German"] }, "webviewInstallMode": { "type": "offlineInstaller" } } }
}
