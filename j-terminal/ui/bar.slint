                height: Theme.day-head-height;
                HorizontalLayout {
                    padding-left: Theme.padding; padding-right: Theme.padding; spacing: Theme.gap;
                    Text {
                        text: root.day-heading; color: Theme.strong; font-size: Theme.day-head-size; font-weight: Theme.weight-semibold;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        TouchArea { clicked => { if !root.day-is-today { root.day-today(); } } }
                    }
                    for icon[k] in root.day-new-icons: Rectangle {
                        width: Theme.day-new-size; height: Theme.day-new-size; y: (parent.height - self.height) / 2;
                        border-radius: Theme.block-radius;
                        background: new-touch.has-hover ? Theme.hover : transparent;
                        Image { width: Theme.day-heading-icon; height: Theme.day-heading-icon; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: icon; colorize: new-touch.has-hover ? Theme.accent : Theme.placeholder; }
                        new-touch := TouchArea { clicked => { root.day-create(k); } }
                    }
                    Rectangle {
                        width: relative-text.preferred-width + Theme.day-pill-inset * 2; height: Theme.day-pill-height;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.height / 2; border-width: Theme.border-width;
                        border-color: root.day-is-today ? Theme.day-pill-border : Theme.edge;
