                                width: chip-text.preferred-width + Theme.day-chip-inset * 2; height: Theme.day-chip-height;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.height / 2; border-width: Theme.border-width; border-color: row.trace ? Theme.edge : Theme.day-pill-border;
                                chip-text := Text { text: row.detail; color: row.trace ? Theme.muted : Theme.accent; font-family: Theme.write-font; font-size: Theme.day-chip-size; horizontal-alignment: center; vertical-alignment: center; }
                            }
