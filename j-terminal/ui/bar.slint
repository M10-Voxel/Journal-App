import { KeyBindings, ShortcutContext, RoutedKey } from "key-bindings.slint";
export { KeyBindings, ShortcutContext, RoutedKey }
import { JournalIcons } from "journal-icons.slint";
export { JournalIcons }
import { NotepadEditor, NotepadChoiceRow, NotepadMarkdownRow, NotepadTool, NotepadIndent, NotepadImage, NotepadLabels } from "notepad.slint";
export { NotepadChoiceRow, NotepadMarkdownRow, NotepadTool, NotepadIndent, NotepadImage, NotepadLabels }
import { Theme } from "theme.slint";
export { Theme }
export { SettingsWindow, SettingsRow, SettingsLabels, SettingsCategory, PreferenceKey, RowControl } from "shortcuts.slint";
import { Calendar, CalBand, CalBlock, CalChip, CalLane, CalTick } from "calendar.slint";
export { CalBand, CalBlock, CalChip, CalLane, CalTick }
import { Footer, FooterHint, KeyCaps, KeyIcons } from "footer.slint";
export { FooterHint, KeyIcons }
import { ActionPopover, MenuRow, SideRow, MonthCell } from "actions.slint";
export { MenuRow, SideRow, MonthCell }
// A command offered under the search bar.
export struct SearchRun { label: string, marked: bool }
export struct CommandRow {
    name: string, detail: string, heading: string, tag: string, icon: image, has-icon: bool,
    sigil: bool, has-color: bool, tint: color, title-runs: [SearchRun], snippet-runs: [SearchRun],
    top: length, tall: length, header: length, preview: bool, description: string,
}

export struct EntryPreview { source: int, index: int, title: string, description: string, x: length, y: length }

component SearchLine inherits Rectangle {
    in property <[SearchRun]> runs;
    in property <bool> small;
    clip: true;
    HorizontalLayout {
        x: 0px; width: self.preferred-width; height: parent.height;
        for run in root.runs: Rectangle {
            width: word.preferred-width; height: word.preferred-height; y: (parent.height - self.height) / 2;
            background: run.marked ? Theme.selection : transparent;
            word := Text { text: run.label; font-size: root.small ? Theme.small-size : Theme.row-size;
                color: root.small && !run.marked ? Theme.muted : Theme.strong; vertical-alignment: center; }
        }
    }
}
// One field of the form: its line (as shown), its place in the line ("when" has three), the line's label and icon on
// its first field, what it holds (or the pale default), and a colour dot (tag) or an icon.
export struct FormRow { field: int, line: int, cell: int, multi: bool, label: string, has-label-icon: bool, label-icon: image, value: string, hint: string, filled: bool, error: bool, has-color: bool, color: color, has-icon: bool, icon: image }
// A choice of the open options (a tag, an icon, a reminder); `index` is what a click chooses.
export struct ChoiceRow { index: int, label: string, has-color: bool, color: color, has-icon: bool, icon: image, selected: bool }
// A choice of the repetition. kind: 0 one of several, 1 switched on/off, 2 a number, 3 a date; `after` follows it.
export struct SentencePart { text: string, kind: int, selected: bool, focused: bool, slot: int, value: int, after: string }
export struct SentenceLine { label: string, has-icon: bool, icon: image, parts: [SentencePart] }
// A line of the day view. kind: 0 a section's heading, 1 an entry, 3 an activity, 4 a quiet empty line, 5 the day's title,
// 6 a timer of another day, 7 the dials. `item` is what the keyboard and the mouse choose (-1 none).
// `detail`: the entry's time, the heading's count, the activity's minutes.
export struct DialCell { color: color, raw: int, low: int, high: int, item: int, label: string, value: string, image: image, selected: bool }
export struct DayRow { top: length, tall: length, column: int, kind: int, item: int, label: string, detail: string, icon: image, has-tag-icon: bool, tag-icon: image, has-color: bool, color: color,
    done: bool, priority: bool, trace: bool, foreign: bool, selected: bool, editing: bool, track: bool, has-timer: bool, timer-running: bool, timer-clock: string,
    // The dials' line: how many side by side, the width of each, the ring's size, the height of a line of them.
    dial-columns: int, dial-cell: length, dial-size: length, dial-row: length, dials: [DialCell], description: string }

// A section's heading, as Raycast's: small, grey, its count beside it.
component DayHeading inherits Rectangle {
    in property <DayRow> data;
    HorizontalLayout {
        y: Theme.day-section-top; height: parent.height - Theme.day-section-top;
        spacing: Theme.gap; alignment: start;
        Text { text: root.data.label; color: Theme.muted; font-size: Theme.day-heading-size; font-weight: Theme.weight-medium; vertical-alignment: center; }
        Text { text: root.data.detail; color: Theme.placeholder; font-size: Theme.day-count-size; vertical-alignment: center; }
    }
}

// A small square that reacts to the pointer: an icon to click.
component IconSpot inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.muted;
    in property <length> icon-size: Theme.day-tag-icon-size;
    callback clicked;
    out property <bool> hovered: spot-touch.has-hover;
    width: Theme.day-symbol-box; height: Theme.day-symbol-box;
    border-radius: Theme.block-radius;
    background: spot-touch.has-hover ? Theme.hover : transparent;
    Image { width: root.icon-size; height: root.icon-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon; colorize: spot-touch.has-hover ? Theme.strong : root.tint; }
    spot-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component DayActivity inherits Rectangle {
    in property <DayRow> data;
    in property <image> icon-play;
    in property <image> icon-pause;
    in property <image> icon-stop;
    callback clicked(int, int);
    HorizontalLayout {
        spacing: Theme.gap;
        Rectangle {
            width: Theme.day-symbol-box; height: Theme.day-symbol-box; y: (parent.height - self.height) / 2;
            border-radius: Theme.block-radius;
            background: tick-touch.has-hover ? Theme.hover : transparent;
            Image {
                width: Theme.day-symbol-size; height: Theme.day-symbol-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                source: root.data.icon; colorize: root.data.done || root.data.kind == 6 ? (root.data.has-color ? root.data.color : Theme.strong) : Theme.placeholder;
            }
            tick-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(root.data.item, 1); } }
        }
        Text {
            text: root.data.label; color: root.data.done || root.data.kind == 6 ? Theme.text : Theme.muted; font-size: Theme.row-size; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            TouchArea { clicked => { root.clicked(root.data.item, 0); } }
        }
        if root.data.detail != "": Text { text: root.data.detail; color: Theme.muted; font-family: Theme.write-font; font-size: Theme.write-size; vertical-alignment: center; }
        if root.data.has-timer: Text { text: root.data.timer-clock; color: root.data.timer-running ? Theme.accent : Theme.muted; font-family: Theme.write-font; font-size: Theme.write-size; vertical-alignment: center; }
        if root.data.track: IconSpot {
            y: (parent.height - self.height) / 2;
            icon: root.data.timer-running ? root.icon-pause : root.icon-play; tint: root.data.timer-running ? Theme.accent : Theme.placeholder;
            clicked => { root.clicked(root.data.item, 2); }
        }
        if root.data.has-timer: IconSpot {
            y: (parent.height - self.height) / 2;
            icon: root.icon-stop; tint: Theme.placeholder;
            clicked => { root.clicked(root.data.item, 3); }
        }
    }
}

component DayScroll inherits Flickable {
    in property <length> focus-y;
    in property <length> focus-h;
    min-height: 0px;
    preferred-height: 0px;
    function reveal-focus() {
        if self.focus-h > 0px {
            self.content-y = min(self.content-y, -self.focus-y);
            self.content-y = max(self.content-y, min(0px, self.height - self.focus-y - self.focus-h));
        }
        self.content-y = clamp(self.content-y, min(0px, self.height - self.content-height), 0px);
    }
    changed focus-y => { self.reveal-focus(); }
    changed focus-h => { self.reveal-focus(); }
    changed height => { self.reveal-focus(); }
    changed content-height => { self.reveal-focus(); }
}

export component Bar inherits Window {
    // The form
    in property <[FormRow]> rows;
    in property <int> line-count;
    in property <int> active;
    in property <int> active-line;
    in property <int> active-cell;
    in property <bool> active-multi;
    // The input shows the active field's text; otherwise the keys go to the field's switch or its open options.
    in property <bool> editable;
    in property <bool> native-arrows;
    in property <bool> day-picker-open;
    in property <bool> options;
    in property <[string]> type-names;
    in property <[image]> type-icons;
    in property <int> type-selected;
    in property <string> placeholder;
    // The title and the type in the top line; the flag beside them.
    in property <string> title-text;
    in property <string> title-hint;
    in property <bool> in-header;
    in property <bool> title-error;
    in property <bool> entry-priority;
    in-out property <string> text <=> input.text;
    callback edited(string);
    // Every key the form has a use for: the key's number and the modifiers (1 Shift, 2 Strg, 4 Alt).
    callback form-key(int, int);
    // A click on a field of the form (its index).
    callback field-clicked(int);
    // The open options: 0 none, 1 tags, 2 icons, 3 reminders, 4 the repetition, 5 the clock, 6 the calendar.
    in property <int> panel-kind;
    in property <[ChoiceRow]> choices;
    in property <[SentenceLine]> sentence;
    in property <string> panel-label;
    in property <string> panel-note;
    in property <string> clock-hours;
    in property <string> clock-minutes;
    in property <bool> clock-on-minutes;
    in property <image> panel-icon;
    callback choice-clicked(int);
    callback sentence-clicked(int, int);
    // The calendar beside the form
    in property <[CalBand]> cal-bands;
    in property <[CalBlock]> cal-blocks;
    in property <[CalChip]> cal-chips;
    in property <[CalLane]> cal-lanes;
    in property <[CalTick]> cal-ticks;
    in property <length> cal-time-x;
    in property <string> cal-title;
    in property <image> cal-icon;
    in property <bool> cal-has-now;
    in property <length> cal-now-x;
    in property <length> cal-now-y;
    in property <length> cal-now-h;
    in property <bool> cal-has-caret;
    in property <length> cal-caret-x;
    in property <length> cal-caret-y;
    in property <length> cal-caret-w;
    in property <length> cal-caret-h;
    in property <bool> cal-focus;
    changed cal-focus => { if root.stacked { page-scroll.content-y = root.cal-focus ? min(0px, root.height - root.full-height) : 0px; } }
    callback cal-mouse(int, int, length, length, bool);
    callback calendar-hover-preview(length, length) -> EntryPreview;
    callback calendar-keyboard-preview(int) -> EntryPreview;
    callback day-keyboard-preview() -> EntryPreview;
    callback cal-wheel(length, length, bool, bool);
    callback calendar-resized(length, length);
    private property <length> calendar-viewport-width: calendar.width;
    changed calendar-viewport-width => { root.calendar-resized(calendar.width, calendar.height); }
    private property <length> calendar-viewport-height: calendar.height;
    changed calendar-viewport-height => { root.calendar-resized(calendar.width, self.calendar-viewport-height); }
    // The search bar
    in property <bool> entry-open;
    in property <string> search-placeholder;
    in property <image> search-icon;
    in property <[CommandRow]> commands;
    in property <int> command-selected;
    in property <string> search-list-hint;
    in-out property <string> search-text <=> search.text;
    callback search-edited(string, int);
    callback search-cursor-moved(string, int);
    public function place-search-cursor(offset: int) { search.set-selection-offsets(offset, offset); }
    callback command-chosen(int);

    in property <bool> notepad-open;
    in property <string> notepad-heading;
    in property <string> notepad-date;
    in-out property <string> notepad-title;
    in-out property <string> notepad-body;
    in property <string> notepad-title-label;
    in property <string> notepad-body-label;
    in property <NotepadLabels> notepad-labels;
    property <int> notepad-focus-request;
    in property <bool> notepad-editing;
    in property <bool> notepad-can-save;
    in property <int> notepad-panel;
    in property <bool> notepad-preview;
    in property <[NotepadChoiceRow]> notepad-choices;
    in property <[NotepadMarkdownRow]> notepad-markdown;
    in property <[NotepadTool]> notepad-tools;
    in property <string> notepad-editor-heading;
    in property <string> notepad-panel-placeholder;
    in property <string> notepad-panel-empty;
    in property <string> notepad-image-label;
    in property <image> notepad-image-icon;
    in property <image> notepad-link-icon;
    in property <image> notepad-check-icon;
    in property <image> notepad-copy-icon;
    in property <string> notepad-copy-label;
    in property <string> notepad-all-notes;
    in property <string> notepad-day-notes;
    in property <bool> notepad-on-day;
    in property <[NotepadImage]> notepad-images;
    in property <bool> notepad-viewer-open;
    in property <image> notepad-viewed-image;
    in property <string> notepad-viewed-title;
    in property <string> notepad-viewer-message;
    in-out property <string> notepad-query;
    callback notepad-tool(int);
    callback notepad-filter(string);
    callback notepad-new-note;
    pure callback notepad-continue-list(string, int, int) -> NotepadIndent;
    callback notepad-choose(string);
    callback notepad-link(string);
    callback notepad-image;
    callback notepad-check(int);
    callback notepad-scope(bool);
    callback notepad-view-attachment(string);
    callback notepad-close-viewer;
    pure callback notepad-indent-edit(string, int, int, bool) -> NotepadIndent;
    callback notepad-follow(string);
    callback open-notepad;
    callback notepad-edited(bool, string);
    callback notepad-finish(bool);
    // A short message in the footer (saved, an error); errors stay until the next.
    in property <string> notice;
    in property <bool> notice-is-error;
    // The day view under the search bar while no form is open; its day beside the search.
    in property <string> day-heading;
    in property <string> day-relative;
    in property <bool> day-is-today;
    in property <[DayRow]> day-rows;
    in property <[DayRow]> day-footer-rows;
    in property <length> day-footer-height;
    in property <bool> day-focus-footer;
    in property <string> day-title-placeholder;
    in property <string> day-edit-text;
    in property <length> day-focus-y;
    in property <length> day-focus-h;
    in property <image> icon-play;
    in property <image> icon-pause;
    in property <image> icon-stop;
    in property <image> icon-close;
    in property <image> icon-back;
    in property <image> icon-forward;
    in property <image> icon-arrow-back;
    in property <image> icon-flag;
    in property <image> icon-chevron-down;
    in property <image> icon-success;
    in property <image> icon-error;
    callback day-today();
    // Every key the day view (and its pickers) has a use for: the key's text and the modifiers (1 Shift, 2 Strg, 4 Alt).
    callback day-key(string, int);
    callback release-plan-space();
    callback day-shortcut(string, int) -> bool;
    callback day-edited(string);
    // A click on a line: its item and the part (0 text, 1 symbol, 2 timer start/pause, 3 timer stop, 4 right click,
    // 5 the flag).
    callback day-click(int, int);
    // A dial: where the pointer is from its centre; the wheel over it.
    out property <bool> dragging-dial;
    in property <length> day-list-height;
    pure callback dial-preview(int, int, int, color) -> image;
    callback dial-set(int, int, bool);
    callback dial-point(int, length, length);
    callback dial-wheel(int, length);
    // An entry's picker in the popover (tags, icons, reminders, clock, month, description).
    in property <bool> side-open;
    in property <int> side-focus-index: -1;
    in property <int> side-kind;
    in property <string> side-title;
    in property <string> side-heading;
    in property <image> side-heading-icon;
    in property <[SideRow]> side-rows;
    in property <string> side-clock-hours;
    in property <string> side-clock-minutes;
    in property <bool> side-clock-on-minutes;
    in property <string> side-month-title;
    in property <[string]> side-weekdays;
    in property <[MonthCell]> side-cells;
    in property <string> side-confirm-text;
    in property <string> side-text;
    in property <string> side-text-shown;
    in property <string> side-placeholder;
    callback side-choose(int);
    callback side-edited(string);
    callback side-day(int);
    callback side-month(int);
    callback side-confirm();
    callback side-close();
    callback side-back();
    // The clock: a part clicked (steps 0) or turned with the wheel.
    callback side-clock(bool, int);
    // The actions behind Strg+K.
    in property <bool> menu-open;
    in property <bool> app-menu;
    in property <string> menu-title;
    in property <[MenuRow]> menu-rows;
    in property <int> menu-pick;
    in property <string> menu-placeholder;
    in property <string> menu-empty;
    callback toggle-menu();
    callback menu-edited(string);
    callback menu-key(string, int);
    callback menu-choose(int);
    private property <int> popover-focus;
    // The footer: where one is, its main action and the actions.
    in property <string> footer-label;
    in property <[FooterHint]> footer-hints;
    in property <bool> footer-date;
    in property <string> footer-menu-label;
    callback app-menu-clicked();
    callback footer-action(int);
    callback open-settings();
    private property <length> value-x: Theme.padding + Theme.label-width;
    public function focus-input() { input.focus(); }
    public function focus-line() { if root.entry-open { input.focus(); input.select-all(); } else if root.notepad-open { root.focus-notepad(); } else { search.focus(); } }
    public function focus-notepad() { root.notepad-focus-request += 1; }
    public function focus-entry() { input.focus(); input.select-all(); }
    public function focus-search() { search.focus(); }
    public function focus-day() { day-scope.focus(); }
    public function focus-menu() { root.popover-focus += 1; }
    public function select-text() { input.select-all(); }
    // Where a field of a line lies: "when" has the date, the start and the end side by side.
    pure function cell-x(cell: int) -> length {
        return root.value-x + (cell == 0 ? 0px : cell == 1 ? Theme.when-date-width : Theme.when-date-width + Theme.when-time-width + Theme.when-dash-width);
    }
    pure function cell-width(cell: int, multi: bool) -> length {
        return !multi ? root.form-space - root.value-x - Theme.padding : cell == 0 ? Theme.when-date-width - Theme.gap : Theme.when-time-width;
    }
    pure function mods(shift: bool, control: bool, alt: bool) -> int { return (shift ? 1 : 0) + (control ? 2 : 0) + (alt ? 4 : 0); }

    in property <length> screen-width: Theme.width + Theme.border-width;
    in property <length> screen-height: Theme.calendar-height * 4;
    out property <bool> stacked: root.screen-width < Theme.width;
    out property <length> content-width: root.stacked ? min(root.screen-width, Theme.calendar-width) : min(root.screen-width, Theme.width);
    out property <length> form-space: root.stacked ? root.content-width : Theme.form-width;
    property <length> stacked-height: min(root.screen-height, Theme.calendar-height * 2);
    property <length> preferred-pane-height: root.stacked
        ? max(Theme.stacked-day-min-height, root.stacked-height * Theme.stacked-day-share)
        : Theme.calendar-height;
    property <length> pane-height: max(layout.preferred-height, root.preferred-pane-height);
    property <length> calendar-height: root.stacked
        ? max(Theme.stacked-calendar-min-height, root.stacked-height - root.pane-height - Theme.border-width)
        : root.pane-height;
    property <length> full-height: root.stacked ? root.pane-height + Theme.border-width + root.calendar-height : root.pane-height;
    out property <length> content-height: min(root.full-height, root.screen-height);
    // The top line of the form: where the title's input begins and how much room the type and the flag leave it.
    property <length> title-x: Theme.padding + Theme.back-size + Theme.gap;
    property <length> title-width: root.form-space - root.title-x - Theme.padding - type-chip.width - flag.width - Theme.accessory-gap * 2;
    property <bool> type-list-open;
    pure callback preview-body(string) -> styled-text;
    private property <length> search-scroll;
    private property <length> day-scroll-offset;
    private property <bool> over-preview;
    private property <int> preview-scroll-step;
    out property <length> preview-scroll-y;
    private property <EntryPreview> preview-target;
    private property <bool> preview-ready;
    private property <bool> keyboard-preview;
    private property <int> preview-step;
    out property <string> entry-preview-title: root.preview-ready ? root.preview-target.title : "";
    out property <string> entry-preview-description: root.preview-ready ? root.preview-target.description : "";
    public function dismiss-preview() {
        root.preview-target = {};
        root.over-preview = false;
        root.preview-scroll-y = 0px;
        leave-delay.running = false;
        root.preview-ready = false;
        root.keyboard-preview = false;
        root.preview-step = 0;
        preview-delay.running = false;
    }
    function leave-preview(source: int, index: int) {
        if !root.keyboard-preview && root.preview-target.source == source && root.preview-target.index == index { leave-delay.running = true; }
    }
    function hover-preview(target: EntryPreview) {
        if root.menu-open || root.side-open || root.keyboard-preview { return; }
        if target.title == "" { root.leave-preview(root.preview-target.source, root.preview-target.index); return; }
        leave-delay.running = false;
        if target.source == root.preview-target.source && target.index == root.preview-target.index
            && target.title == root.preview-target.title && target.description == root.preview-target.description { return; }
        root.preview-target = target;
        root.preview-ready = false;
        preview-delay.running = false;
        preview-delay.running = true;
    }
    function show-keyboard-preview() {
        let step = root.preview-step;
        let was-open = root.keyboard-preview;
        root.dismiss-preview();
        if root.menu-open || root.side-open || root.notepad-open { return; }
        if root.cal-focus {
            let target = root.calendar-keyboard-preview(step);
            root.preview-target = { source: target.source, index: target.index, title: target.title, description: target.description,
                x: target.x + calendar.absolute-position.x, y: target.y + calendar.absolute-position.y };
            root.preview-step = step + 1;
        } else if !was-open && search.has-focus && root.commands.length > 0 {
            let row = root.commands[root.command-selected];
            if row.preview { root.preview-target = { source: 1, index: root.command-selected, title: row.name, description: row.description, x: Theme.padding * 3, y: Theme.line-height + root.search-scroll + row.top + row.tall + page-scroll.content-y }; }
        } else if !was-open && day-scope.has-focus {
            let target = root.day-keyboard-preview();
            root.preview-target = { source: target.source, index: target.index, title: target.title, description: target.description,
                x: Theme.padding * 3, y: Theme.line-height + Theme.calendar-gap + root.day-scroll-offset + root.day-focus-y + root.day-focus-h + page-scroll.content-y };
        }
        root.preview-ready = root.preview-target.title != "";
        root.keyboard-preview = root.preview-ready;
    }
    leave-delay := Timer { interval: Theme.preview-crossing-time; running: false;
        triggered => { self.running = false; if !root.over-preview { root.dismiss-preview(); } }
    }
    preview-delay := Timer {
        interval: Theme.entry-preview-delay; running: false;
        triggered => { root.preview-ready = true; self.running = false; }
    }
    changed entry-open => { root.type-list-open = false; root.dismiss-preview(); }
    changed notepad-open => { root.dismiss-preview(); }
    changed menu-open => { root.dismiss-preview(); }
    changed side-open => { root.dismiss-preview(); }
    title: "J-TerminaL";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.content-width;
    height: root.content-height;
    default-font-family: Theme.ui-font;
    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        capture-key-released(event) => {
            if event.text == " " { root.release-plan-space(); }
            reject
        }
        capture-key-pressed(raw-event) => {
            let event = KeyBindings.translate(ShortcutContext.window, raw-event);
            if event.text == Key.F3 && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt {
                if !event.repeat { root.show-keyboard-preview(); }
                return accept;
            }
            if root.keyboard-preview && (event.text == Key.PageDown || event.text == Key.PageUp) {
                root.preview-scroll-step += event.text == Key.PageDown ? 1 : -1; return accept;
            }
            if event.text == Key.Escape && root.keyboard-preview { root.dismiss-preview(); return accept; }
            if event.text != Key.Control && event.text != Key.Shift && event.text != Key.Alt && event.text != Key.Meta { root.dismiss-preview(); }
            if event.text == Key.F1 {
                if !event.repeat { root.open-settings(); }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt &&
                (event.text == "n" || event.text == "N") {
                if !event.repeat {
                    if event.modifiers.shift { root.notepad-new-note(); } else { root.open-notepad(); }
                }
                return accept;
            }
            // The actions, from anywhere (Strg+K).
            if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && (event.text == "k" || event.text == "K") {
                if !event.repeat { root.toggle-menu(); }
                return accept;
            }
            if !root.entry-open && !root.notepad-open {
                if root.day-shortcut(raw-event.text, KeyBindings.modifier-mask(raw-event)) { return accept; }
            }
            reject
        }
    Rectangle {
        background: Theme.background;
        border-radius: Theme.radius;
        clip: true;
    page-scroll := Flickable {
    changed content-y => { root.dismiss-preview(); }
    x: 0px; y: 0px; width: root.width; height: root.height;
    interactive: !root.dragging-dial;
    content-height: root.full-height;
    content-width: root.width;
    layout := VerticalLayout {
        x: 0px; y: 0px;
        height: root.pane-height; width: root.form-space;
        spacing: 0px;
        // ----- The top line: the search and the day it shows, or the entry's title, flag and type -----
        Rectangle {
            visible: !root.notepad-open;
            height: root.notepad-open ? 0px : Theme.line-height;
            // The search: an icon and a large borderless input; the day at the right.
            Rectangle {
                visible: !root.entry-open;
                Image {
                    x: Theme.padding; y: (parent.height - self.height) / 2;
                    width: Theme.search-icon-size; height: Theme.search-icon-size;
                    source: root.search-icon; colorize: Theme.muted;
                }
                if search.text == "": Text {
                    x: search.x; width: search.width; height: parent.height; vertical-alignment: center;
                    text: root.search-placeholder; color: Theme.placeholder; font-size: Theme.search-size; overflow: elide;
                }
                search := TextInput {
                    x: Theme.padding + Theme.search-icon-size + Theme.gap + Theme.calendar-gap;
                    width: day-switch.x - self.x - Theme.gap; height: parent.height;
                    vertical-alignment: center; single-line: true;
                    color: Theme.strong; selection-background-color: Theme.selection; selection-foreground-color: Theme.strong; font-size: Theme.search-size;
                    edited => { root.search-edited(self.text, self.cursor-position-byte-offset); }
                    cursor-position-changed(_) => { root.search-cursor-moved(self.text, self.cursor-position-byte-offset); }
                    key-pressed(raw-event) => {
                        let event = KeyBindings.translate(ShortcutContext.search, raw-event);
                        // Modifier keys alone do nothing (their codes are control characters too).
                        if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
                        if root.day-picker-open {
                            if event.text == Key.LeftArrow { root.form-key(5, 0); return accept; }
                            if event.text == Key.RightArrow { root.form-key(6, 0); return accept; }
                            if event.text == Key.PageUp { root.form-key(7, 0); return accept; }
                            if event.text == Key.PageDown { root.form-key(8, 0); return accept; }
                            if event.text == Key.Home { root.form-key(9, 0); return accept; }
                        }
                        if event.text == Key.F6 { root.form-key(15, 0); return accept; }
                        if event.text == Key.Tab { root.form-key(0, 0); return accept; }
                        if event.text == Key.UpArrow { root.form-key(1, 0); return accept; }
                        if event.text == Key.DownArrow { root.form-key(2, 0); return accept; }
                        if event.text == Key.Return { root.form-key(3, root.mods(event.modifiers.shift, event.modifiers.control, false)); return accept; }
                        if event.text == Key.Escape { root.form-key(4, 0); return accept; }
                        // The day view's day: Alt+←/→ a day back and on, Alt+H today.
                        if event.modifiers.alt && !event.modifiers.control {
                            if event.text == Key.LeftArrow { root.form-key(5, 4); return accept; }
                            if event.text == Key.RightArrow { root.form-key(6, 4); return accept; }
                            if event.text == "h" || event.text == "H" { root.form-key(9, 4); return accept; }
                        }
                        if event.modifiers.control {
                            if event.text == "z" || event.text == "Z" { root.form-key(50, 0); return accept; }
                            if event.text == "y" || event.text == "Y" { root.form-key(51, 0); return accept; }
                            if event.text == "q" || event.text == "Q" { root.form-key(52, 0); return accept; }
                        }
                        reject
                    }
                }
                // The distance from today and the day arrows at the right.
                day-switch := HorizontalLayout {
                    x: parent.width - Theme.padding + Theme.accessory-gap - self.preferred-width;
                    width: self.preferred-width; height: parent.height;
                    spacing: 0px;
                    Rectangle {
                        width: day-label.preferred-width + Theme.accessory-inset * 2; height: Theme.accessory-height;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.block-radius;
                        background: day-touch.has-hover && !root.day-is-today ? Theme.hover : transparent;
                        day-label := HorizontalLayout {
                            padding-left: Theme.accessory-inset; padding-right: Theme.accessory-inset; spacing: Theme.calendar-gap * 2;
                            Text { text: root.day-relative; color: root.day-is-today ? Theme.accent : Theme.muted; font-size: Theme.row-size; font-weight: Theme.weight-medium; vertical-alignment: center; }
                        }
                        day-touch := TouchArea { mouse-cursor: root.day-is-today ? MouseCursor.default : MouseCursor.pointer; clicked => { if !root.day-is-today { root.day-today(); } } }
                    }
                    IconSpot { y: (parent.height - self.height) / 2; icon: root.icon-back; clicked => { root.form-key(5, 4); } }
                    IconSpot { y: (parent.height - self.height) / 2; icon: root.icon-forward; clicked => { root.form-key(6, 4); } }
                }
            }
            // The entry: back, its title, the flag and the type.
            Rectangle {
                visible: root.entry-open;
                IconSpot {
                    x: Theme.padding - Theme.calendar-gap; y: (parent.height - self.height) / 2;
                    width: Theme.back-size; height: Theme.back-size;
                    background: Theme.raised;
                    icon: root.icon-arrow-back; icon-size: Theme.label-icon-size; tint: Theme.text;
                    clicked => { root.form-key(34, 0); }
                }
                // The title while another field has the keyboard (a click: back into it).
                if root.active != 1: Text {
                    x: root.title-x; width: root.title-width; height: parent.height;
                    text: root.title-text != "" ? root.title-text : root.title-hint;
                    color: root.title-error ? Theme.error : root.title-text != "" ? Theme.strong : Theme.placeholder;
                    font-family: Theme.write-font; font-size: Theme.search-size; vertical-alignment: center; overflow: elide;
                    TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.field-clicked(1); } }
                }
                flag := IconSpot {
                    x: type-chip.x - self.width - Theme.accessory-gap; y: (parent.height - self.height) / 2;
                    icon: root.icon-flag; icon-size: Theme.label-icon-size;
                    tint: root.entry-priority ? Theme.priority : Theme.placeholder;
                    background: root.entry-priority ? Theme.priority.with-alpha(0.14) : self.hovered ? Theme.hover : transparent;
                    clicked => { root.form-key(30, 4); input.focus(); }
                }
                // The type, as a choice in the top line (Alt+1–4; a click lists them).
                type-chip := Rectangle {
                    x: parent.width - Theme.padding - self.width; y: (parent.height - self.height) / 2;
                    width: type-row.preferred-width; height: Theme.accessory-height;
                    border-radius: Theme.block-radius;
                    background: root.active == 0 || root.type-list-open ? Theme.row-selection : type-touch.has-hover ? Theme.hover : Theme.raised;
                    border-width: Theme.border-width; border-color: root.active == 0 ? Theme.field-focus : Theme.edge;
                    type-row := HorizontalLayout {
                        padding-left: Theme.accessory-inset; padding-right: Theme.accessory-inset - 2px; spacing: Theme.calendar-gap * 2;
                        if root.type-icons.length > root.type-selected: Image {
                            width: Theme.label-icon-size - 2px; height: self.width; y: (parent.height - self.height) / 2;
                            source: root.type-icons[root.type-selected]; colorize: Theme.text;
                        }
                        Text { text: root.type-names[root.type-selected]; color: Theme.strong; font-size: Theme.type-size; vertical-alignment: center; }
                        Image { width: Theme.footer-icon-size; height: self.width; y: (parent.height - self.height) / 2; source: root.icon-chevron-down; colorize: Theme.muted; }
                    }
                    type-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.type-list-open = !root.type-list-open; input.focus(); } }
                }
            }
        }
        if !root.notepad-open: Rectangle { height: Theme.border-width; background: Theme.divider; }
        if !root.entry-open && !root.notepad-open && root.commands.length > 0: Flickable {
            property <length> selected-y: root.commands[root.command-selected].top;
            property <length> selected-h: root.commands[root.command-selected].tall;
            changed selected-y => {
                self.content-y = min(0px, max(min(self.content-y, -self.selected-y), self.height - self.selected-y - self.selected-h));
            }
            changed content-y => { root.search-scroll = self.content-y; root.dismiss-preview(); }
            init => { root.search-scroll = self.content-y; }
            content-height: root.commands[root.commands.length - 1].top + root.commands[root.commands.length - 1].tall;
            height: min(self.content-height, Theme.popover-max-height);
            for command[index] in root.commands: Rectangle {
                x: Theme.popover-padding; width: parent.width - self.x * 2; y: command.top; height: command.tall;
                if command.header > 0px: Text {
                    x: Theme.list-inset; y: 0px; height: command.header; text: command.heading;
                    vertical-alignment: center; color: Theme.muted; font-size: Theme.small-size;
                }
                Rectangle {
                    y: command.header; height: parent.height - self.y;
                    border-radius: Theme.list-radius;
                    background: index == root.command-selected ? Theme.row-selection : hit.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: Theme.list-inset; padding-right: Theme.list-inset; spacing: Theme.gap;
                        if command.sigil: Text { text: "@"; color: Theme.muted; vertical-alignment: center; }
                        if command.has-icon: Image { source: command.icon; width: Theme.label-icon-size; height: self.width;
                            y: (parent.height - self.height) / 2; colorize: command.tint; }
                        if command.has-color && !command.has-icon: Rectangle { width: Theme.label-icon-size / 2; height: self.width;
                            y: (parent.height - self.height) / 2; background: command.tint; border-radius: self.width / 2; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            SearchLine { runs: command.title-runs; }
                            if command.snippet-runs.length > 0: SearchLine { small: true; runs: command.snippet-runs; }
                        }
                        if command.tag != "": Rectangle { width: Theme.label-icon-size / 2; height: self.width;
                            y: (parent.height - self.height) / 2; background: command.tint; border-radius: self.width / 2; }
                        if command.tag != "": Text { text: command.tag; color: Theme.muted; max-width: root.form-space / 5;
                            overflow: elide; font-size: Theme.small-size; vertical-alignment: center; }
                        Text { text: command.detail; color: Theme.muted; font-size: Theme.small-size; vertical-alignment: center; }
                    }
                    hit := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover && command.preview {
                                root.hover-preview({ source: 1, index: index, title: command.name, description: command.description,
                                    x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.height });
                            } else { root.leave-preview(1, index); }
                        }
                        clicked => { root.dismiss-preview(); root.command-chosen(index); }
                    }
                }
            }
        }
        if !root.entry-open && !root.notepad-open && root.commands.length > 0 && root.search-list-hint != "": Rectangle {
            height: Theme.section-height;
            Rectangle { y: 0px; height: Theme.border-width; background: Theme.divider; }
            Text {
                x: Theme.popover-padding + Theme.list-inset; height: parent.height; text: root.search-list-hint;
                color: Theme.muted; font-size: Theme.small-size; vertical-alignment: center;
            }
        }
        // ----- The entry form under the top line, while open: a label at the left, the field at the right -----
        if root.entry-open && !root.notepad-open: Rectangle {
            height: root.line-count * Theme.form-row-height + Theme.gap;
            for row in root.rows: Rectangle {
                y: Theme.gap / 2 + row.line * Theme.form-row-height;
                height: Theme.form-row-height;
                if row.label != "": Text {
                    x: Theme.padding; width: Theme.label-width - Theme.gap; height: parent.height;
                    text: row.label; color: row.line == root.active-line && !root.in-header ? Theme.strong : Theme.muted;
                    font-size: Theme.label-size; vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                }
                if row.cell == 2: Text {
                    x: root.cell-x(2) - Theme.when-dash-width; width: Theme.when-dash-width; height: parent.height;
                    text: "–"; color: Theme.muted; font-size: Theme.form-size; horizontal-alignment: center; vertical-alignment: center;
                }
                // A field: quiet grey with a fine edge; lighter while it has the keyboard.
                Rectangle {
                    x: root.cell-x(row.cell); y: Theme.field-vpad;
                    width: root.cell-width(row.cell, row.multi); height: parent.height - Theme.field-vpad * 2;
                    background: row.field == root.active ? Theme.field-focus-background : field-touch.has-hover ? Theme.hover : Theme.field-background;
                    border-radius: Theme.field-radius;
                    border-width: Theme.border-width;
                    border-color: row.error ? Theme.error : row.field == root.active ? Theme.field-focus : Theme.edge;
                    field-touch := TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.field-clicked(row.field); } }
                }
                if !(row.field == root.active && root.editable): HorizontalLayout {
                    x: root.cell-x(row.cell) + Theme.field-inset; width: root.cell-width(row.cell, row.multi) - Theme.field-inset * 2; height: parent.height;
                    spacing: Theme.gap;
                    alignment: start;
                    if row.has-color && row.filled: Rectangle {
                        width: Theme.tag-dot; height: Theme.tag-dot; y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2; background: row.color;
                    }
                    if row.has-icon && row.filled: Image {
                        width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2;
                        source: row.icon; colorize: Theme.text;
                    }
                    Text {
                        text: row.filled ? row.value : row.hint;
                        color: row.error ? Theme.error : row.filled ? Theme.text : Theme.placeholder;
                        font-family: row.field == 8 || row.multi ? Theme.write-font : Theme.ui-font;
                        font-size: Theme.write-size; vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
        // ----- The open options of the active field -----
        if root.entry-open && !root.notepad-open && root.panel-kind > 0: HorizontalLayout {
            padding-left: Theme.padding; padding-right: Theme.padding; padding-bottom: Theme.gap;
            Rectangle {
            height: panel.preferred-height;
            clip: true;
            background: Theme.panel-background;
            border-radius: Theme.panel-radius;
            border-width: Theme.border-width;
            border-color: Theme.panel-border;
            panel := VerticalLayout {
            padding: Theme.panel-padding;
            spacing: Theme.panel-spacing;
            // A heading: what the options are about.
            if root.panel-label != "": HorizontalLayout {
                spacing: Theme.gap; alignment: start;
                Image { width: Theme.label-icon-size; height: Theme.label-icon-size; source: root.panel-icon; colorize: Theme.muted; y: (parent.height - self.height) / 2; }
                Text { text: root.panel-label; color: Theme.text; font-size: Theme.row-size; font-weight: Theme.weight-medium; vertical-alignment: center; }
            }
            // Tags: a list with their colours.
            if root.panel-kind == 1: VerticalLayout {
                spacing: Theme.choice-spacing;
                for choice in root.choices: Rectangle {
                    height: Theme.choice-height;
                    background: choice.selected ? Theme.row-selection : tag-touch.has-hover ? Theme.hover : transparent;
                    border-radius: Theme.block-radius;
                    HorizontalLayout {
                        padding-left: Theme.gap; spacing: Theme.gap; alignment: start;
                        Rectangle {
                            width: Theme.tag-dot; height: Theme.tag-dot; y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2; background: choice.has-color ? choice.color : transparent;
                            border-width: choice.has-color ? 0px : Theme.border-width; border-color: Theme.placeholder;
                        }
                        if choice.has-icon: Image { source: choice.icon; width: Theme.label-icon-size; height: Theme.label-icon-size; colorize: choice.has-color ? choice.color : Theme.muted; y: (parent.height - self.height) / 2; }
                        Text { text: choice.label; color: choice.selected ? Theme.strong : Theme.text; font-size: Theme.row-size; vertical-alignment: center; }
                    }
                    tag-touch := TouchArea { clicked => { root.choice-clicked(choice.index); input.focus(); } }
                }
            }
            // Icons: a grid, the chosen one's name under it.
            if root.panel-kind == 2: Rectangle {
                height: Math.ceil(root.choices.length / Theme.icon-columns) * Theme.icon-cell;
                for choice[i] in root.choices: Rectangle {
                    x: Math.mod(i, Theme.icon-columns) * Theme.icon-cell;
                    y: Math.floor(i / Theme.icon-columns) * Theme.icon-cell;
                    width: Theme.icon-cell - Theme.calendar-gap; height: Theme.icon-cell - Theme.calendar-gap;
                    background: choice.selected ? Theme.row-selection : icon-touch.has-hover ? Theme.hover : transparent;
                    border-radius: Theme.block-radius;
                    border-width: choice.selected ? Theme.border-width : 0px; border-color: Theme.field-focus;
                    Image {
                        width: Theme.icon-size; height: Theme.icon-size;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        source: choice.icon; colorize: choice.selected ? Theme.strong : Theme.muted;
                    }
                    icon-touch := TouchArea { clicked => { root.choice-clicked(choice.index); input.focus(); } }
                }
            }
            // Reminders: ready-made lengths in a grid; anything else is typed.
            if root.panel-kind == 3: Rectangle {
                height: Math.ceil(root.choices.length / Theme.reminder-columns) * Theme.choice-height;
                for choice[i] in root.choices: Rectangle {
                    x: Math.mod(i, Theme.reminder-columns) * (parent.width / Theme.reminder-columns);
                    y: Math.floor(i / Theme.reminder-columns) * Theme.choice-height;
                    width: parent.width / Theme.reminder-columns - Theme.calendar-gap; height: Theme.choice-height - Theme.calendar-gap;
                    background: choice.selected ? Theme.chip-selected : reminder-touch.has-hover ? Theme.hover : Theme.recognised;
                    border-radius: Theme.block-radius;
                    border-width: choice.selected ? Theme.border-width : 0px; border-color: Theme.field-focus;
                    Text { text: choice.label; color: choice.selected ? Theme.strong : Theme.muted; font-size: Theme.row-size; horizontal-alignment: center; vertical-alignment: center; }
                    reminder-touch := TouchArea { clicked => { root.choice-clicked(choice.index); input.focus(); } }
                }
            }
            // The repetition: labelled lines; one choice of several looks like a segmented switch, days and months
            // like round switches, numbers and dates like fields.
            if root.panel-kind == 4: VerticalLayout {
                spacing: Theme.sentence-spacing;
                for line in root.sentence: HorizontalLayout {
                    spacing: 0px;
                    Text { width: Theme.sentence-label-width; text: line.label; color: Theme.muted; font-size: Theme.label-size; vertical-alignment: center; overflow: elide; }
                    HorizontalLayout {
                        spacing: Theme.calendar-gap;
                        alignment: start;
                        for part in line.parts: HorizontalLayout {
                            spacing: Theme.calendar-gap;
                            Rectangle {
                                width: part.kind == 1 ? Theme.toggle-width : part-text.preferred-width + Theme.sentence-inset * 2;
                                height: Theme.sentence-height;
                                background: part.kind >= 2 ? Theme.field-background : part.selected ? Theme.chip-selected : Theme.recognised;
                                border-radius: part.kind == 1 ? Theme.sentence-height / 2 : Theme.block-radius;
                                border-width: part.focused || part.kind >= 2 ? Theme.border-width : 0px;
                                border-color: part.focused ? Theme.field-focus : Theme.edge;
                                part-text := Text {
                                    text: part.text; font-size: Theme.row-size;
                                    font-weight: part.selected && part.kind != 2 ? Theme.weight-semibold : Theme.weight-normal;
                                    color: part.selected && part.kind < 2 ? Theme.strong : part.focused || part.kind >= 2 ? Theme.text : Theme.muted;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.sentence-clicked(part.slot, part.value); input.focus(); } }
                            }
                            if part.after != "": Text { text: part.after; color: Theme.muted; font-size: Theme.row-size; vertical-alignment: center; }
                        }
                    }
                }
            }
            // The clock: big hours and minutes, the part with the arrows lit.
            if root.panel-kind == 5: HorizontalLayout {
                alignment: center; spacing: Theme.gap;
                Rectangle {
                    width: hours-text.preferred-width + Theme.clock-inset * 2; height: Theme.clock-box-height;
                    background: !root.clock-on-minutes ? Theme.row-selection : Theme.field-background;
                    border-radius: Theme.block-radius;
                    border-width: Theme.border-width; border-color: !root.clock-on-minutes ? Theme.field-focus : Theme.edge;
                    hours-text := Text { text: root.clock-hours; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.strong; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: ":"; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.muted; vertical-alignment: center; }
                Rectangle {
                    width: minutes-text.preferred-width + Theme.clock-inset * 2; height: Theme.clock-box-height;
                    background: root.clock-on-minutes ? Theme.row-selection : Theme.field-background;
                    border-radius: Theme.block-radius;
                    border-width: Theme.border-width; border-color: root.clock-on-minutes ? Theme.field-focus : Theme.edge;
                    minutes-text := Text { text: root.clock-minutes; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.strong; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if root.panel-note != "": Text { text: root.panel-note; color: Theme.muted; font-size: Theme.small-size; }
            }
            }
        }
        if root.notepad-open: NotepadEditor {
            heading: root.notepad-editor-heading;
            date: root.notepad-date;
            title <=> root.notepad-title;
            body <=> root.notepad-body;
            title-label: root.notepad-title-label; body-label: root.notepad-body-label;
            labels: root.notepad-labels; editing: root.notepad-editing; can-save: root.notepad-can-save;
            back-icon: root.icon-arrow-back; focus-request: root.notepad-focus-request;
            panel: root.notepad-panel; preview: root.notepad-preview;
            choices: root.notepad-choices; markdown: root.notepad-markdown; tools: root.notepad-tools;
            panel-placeholder: root.notepad-panel-placeholder; panel-empty: root.notepad-panel-empty;
            image-label: root.notepad-image-label; image-icon: root.notepad-image-icon; link-icon: root.notepad-link-icon; check-icon: root.notepad-check-icon;
            copy-icon: root.notepad-copy-icon; copy-label: root.notepad-copy-label;
            all-notes: root.notepad-all-notes; day-notes: root.notepad-day-notes; on-day: root.notepad-on-day;
            images: root.notepad-images;
            viewer-open: root.notepad-viewer-open; viewed-image: root.notepad-viewed-image;
            viewed-title: root.notepad-viewed-title; viewer-message: root.notepad-viewer-message;
            query <=> root.notepad-query;
            scope(day) => { root.notepad-scope(day); }
            view-attachment(key) => { root.notepad-view-attachment(key); }
            close-viewer => { root.notepad-close-viewer(); }
            indent-edit(text, anchor, cursor, reverse) => { root.notepad-indent-edit(text, anchor, cursor, reverse) }
            tool(index) => { root.notepad-tool(index); }
            new-note => { root.notepad-new-note(); }
            continue-list(text, anchor, cursor) => { root.notepad-continue-list(text, anchor, cursor) }
            filter(text) => { root.notepad-filter(text); }
            choose(key) => { root.notepad-choose(key); }
            add-link(url) => { root.notepad-link(url); }
            add-image => { root.notepad-image(); }
            check(offset) => { root.notepad-check(offset); }
            follow(url) => { root.notepad-follow(url); }
            edited(body, text) => { root.notepad-edited(body, text); }
            finish(save) => { root.notepad-finish(save); }
        }
        // ----- The day view: a list as in Raycast -----
        if !root.entry-open && !root.notepad-open && root.commands.length == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            DayScroll {
                vertical-stretch: 1;
                changed content-y => { root.day-scroll-offset = self.content-y; root.dismiss-preview(); }
                init => { root.day-scroll-offset = self.content-y; }
                content-height: root.day-list-height + Theme.gap;
                focus-y: root.day-focus-y;
                focus-h: root.day-focus-footer ? 0px : root.day-focus-h;
                Rectangle {
                    x: 0px; y: Theme.calendar-gap;
                    width: layout.width;
                    height: root.day-list-height;
                    for row in root.day-rows: TouchArea {
                        x: Theme.padding; width: parent.width - Theme.padding * 2;
                        y: row.top; height: row.tall;
                        enabled: row.kind == 1 && !row.editing;
                        changed has-hover => {
                            if self.has-hover {
                                root.hover-preview({ source: 2, index: row.item, title: row.label, description: row.description,
                                    x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.height });
                            } else { root.leave-preview(2, row.item); }
                        }
                        // The line the keyboard is on.
                        if row.selected && row.kind != 7: Rectangle {
                            x: -Theme.day-select-inset; width: parent.width + Theme.day-select-inset * 2;
                            background: Theme.row-selection; border-radius: Theme.list-radius;
                        }
                        // The day's title, written in place.
                        if row.kind == 5 && !row.editing: Text {
                            text: row.label != "" ? row.label : root.day-title-placeholder;
                            color: row.label != "" ? Theme.strong : Theme.placeholder; font-family: Theme.write-font; font-size: Theme.form-size;
                            font-weight: row.label != "" ? Theme.weight-medium : Theme.weight-normal;
                            vertical-alignment: center; overflow: elide; width: parent.width;
                            TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.day-click(row.item, 0); } }
                        }
                        if row.kind == 0: DayHeading { data: row; }
                        // An entry: its symbol (a click: its actions), the text (a click: written in), the time and the tag
                        // quiet at the right, the flag (important) last. A right click anywhere: its actions.
                        if row.kind == 1: HorizontalLayout {
                            spacing: Theme.gap;
                            Rectangle {
                                width: Theme.day-symbol-box; height: Theme.day-symbol-box; y: (parent.height - self.height) / 2;
                                opacity: row.done ? Theme.day-done-opacity : 1;
                                border-radius: Theme.block-radius;
                                background: symbol-touch.has-hover ? Theme.hover : transparent;
                                Image {
                                    width: Theme.day-symbol-size; height: Theme.day-symbol-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    source: row.icon; colorize: row.trace || row.foreign ? Theme.placeholder : row.has-color ? row.color : Theme.text;
                                }
                                symbol-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.day-click(row.item, 1); }
                                    pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.day-click(row.item, 4); } }
                                }
                            }
                            if !row.editing: Text {
                                text: row.label; color: row.trace ? Theme.muted : row.selected ? Theme.strong : Theme.text; font-family: Theme.write-font; font-size: Theme.write-size;
                                opacity: row.done ? Theme.day-done-opacity : 1;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                TouchArea {
                                    mouse-cursor: MouseCursor.text;
                                    clicked => { root.day-click(row.item, 0); }
                                    pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.day-click(row.item, 4); } }
                                }
                            }
                            if row.editing: Rectangle {
                                horizontal-stretch: 1;
                                height: Theme.day-row-height - Theme.field-vpad;
                                y: (parent.height - self.height) / 2;
                                background: Theme.field-focus-background; border-radius: Theme.field-radius;
                                border-width: Theme.border-width; border-color: Theme.field-focus;
                                clip: true;
                                entry-input := TextInput {
                                    x: Theme.field-inset; width: parent.width - Theme.field-inset * 2; height: parent.height;
                                    text: root.day-edit-text; single-line: true; vertical-alignment: center;
                                    color: Theme.strong; selection-background-color: Theme.selection; selection-foreground-color: Theme.strong;
                                    font-family: Theme.write-font; font-size: Theme.write-size;
                                    init => { self.focus(); self.select-all(); }
                                    edited => { root.day-edited(self.text); }
                                    key-pressed(raw-event) => {
                                        let event = KeyBindings.translate(ShortcutContext.day-edit, raw-event);
                                        if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
                                        if event.text == Key.Return || event.text == Key.Escape || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab || event.text == Key.Backtab
                                            || (event.text == Key.Backspace && self.text == "") || event.modifiers.alt {
                                            root.day-key(event.text, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt));
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                            if row.detail != "" && !row.editing: Text {
                                text: row.detail; color: row.trace ? Theme.placeholder : Theme.muted; font-family: Theme.write-font; font-size: Theme.day-chip-size;
                                vertical-alignment: center; opacity: row.done ? Theme.day-done-opacity : 1;
                            }
                            if row.has-tag-icon && !row.editing: Image { width: Theme.day-tag-icon-size; height: Theme.day-tag-icon-size; y: (parent.height - self.height) / 2; source: row.tag-icon; colorize: row.has-color ? row.color : Theme.muted; }
                            if !row.has-tag-icon && row.has-color && !row.editing: Rectangle { width: Theme.tag-dot; height: Theme.tag-dot; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: row.color; }
                            // Important: an orange flag; otherwise a faint one while the line is chosen or the pointer is on it.
                            if !row.editing: Rectangle {
                                width: Theme.day-symbol-box - Theme.gap / 2; height: Theme.day-symbol-box; y: (parent.height - self.height) / 2;
                                border-radius: Theme.block-radius;
                                background: flag-touch.has-hover ? Theme.hover : transparent;
                                Image {
                                    width: Theme.day-tag-icon-size; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    source: root.icon-flag;
                                    colorize: row.priority ? Theme.priority : flag-touch.has-hover ? Theme.muted : Theme.placeholder;
                                    visible: row.priority || row.selected || flag-touch.has-hover;
                                    opacity: row.priority || flag-touch.has-hover ? 1 : 0.6;
                                }
                                flag-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.day-click(row.item, 5); } }
                            }
                        }
                        // The day's title being written.
                        if row.kind == 5 && row.editing: Rectangle {
                            height: Theme.day-title-height - Theme.field-vpad; y: (parent.height - self.height) / 2;
                            background: Theme.field-focus-background; border-radius: Theme.field-radius;
                            border-width: Theme.border-width; border-color: Theme.field-focus;
                            clip: true;
                            TextInput {
                                x: Theme.field-inset; width: parent.width - Theme.field-inset * 2; height: parent.height;
                                text: root.day-edit-text; single-line: true; vertical-alignment: center;
                                color: Theme.strong; selection-background-color: Theme.selection; selection-foreground-color: Theme.strong;
                                font-family: Theme.write-font; font-size: Theme.form-size;
                                init => { self.focus(); self.select-all(); }
                                edited => { root.day-edited(self.text); }
                                key-pressed(raw-event) => {
                                    let event = KeyBindings.translate(ShortcutContext.day-edit, raw-event);
                                    if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
                                    if event.text == Key.Return || event.text == Key.Escape || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab || event.text == Key.Backtab || event.modifiers.alt {
                                        root.day-key(event.text, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt));
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                        if row.kind == 3 || row.kind == 6: DayActivity {
                            data: row; icon-play: root.icon-play; icon-pause: root.icon-pause; icon-stop: root.icon-stop;
                            clicked(item, part) => { root.day-click(item, part); }
                        }
                        if row.kind == 4: HorizontalLayout {
                            spacing: Theme.gap; alignment: start;
                            Image { width: Theme.day-symbol-size; height: Theme.day-symbol-size; y: (parent.height - self.height) / 2; source: row.icon; colorize: Theme.placeholder; }
                            Text { text: row.label; color: Theme.placeholder; font-size: Theme.row-size; vertical-alignment: center; }
                        }
                    }
                }
            }
            day-footer := DayScroll {
                interactive: !root.dragging-dial;
                height: min(self.content-height, root.preferred-pane-height * Theme.day-footer-share);
                content-height: root.day-footer-height + Theme.day-bottom;
                focus-y: root.day-focus-y;
                focus-h: root.day-focus-footer ? root.day-focus-h : 0px;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: root.day-footer-height;
                    for row in root.day-footer-rows: Rectangle {
                        property <length> inner: parent.width - Theme.padding * 2;
                        width: row.column == 0 ? self.inner : (self.inner - Theme.gap) / 2;
                        x: Theme.padding + (row.column == 2 ? self.width + Theme.gap : 0px);
                        y: row.top; height: row.tall;
                        if row.selected: Rectangle {
                            x: -Theme.day-select-inset; width: parent.width + Theme.day-select-inset * 2;
                            background: Theme.row-selection; border-radius: Theme.list-radius;
                        }
                        if row.kind == 0: DayHeading { data: row; }
                        // The rating and the day values: round dials side by side. A click or drag on the ring sets the value
                        // by its place, the wheel steps it.
                        if row.kind == 7: Rectangle {
                            property <int> columns: max(1, row.dial-columns);
                            for dial[i] in row.dials: Rectangle {
                                x: mod(i, parent.columns) * (row.dial-cell + Theme.dial-spacing);
                                y: floor(i / parent.columns) * row.dial-row;
                                height: row.dial-row; width: row.dial-cell;
                                border-radius: Theme.list-radius;
                                background: dial.selected ? Theme.row-selection : transparent;
                                Image {
                                    x: (parent.width - self.width) / 2; y: Theme.dial-top;
                                    width: row.dial-size; height: row.dial-size;
                                    source: dial-touch.pressed && dial-touch.adjusted
                                        ? root.dial-preview(dial-touch.preview, dial.low, dial.high, dial.color) : dial.image;
                                }
                                Text {
                                    x: 0px; y: Theme.dial-top; width: parent.width; height: row.dial-size;
                                    text: dial-touch.pressed && dial-touch.adjusted ? "\{dial-touch.preview}" : dial.value; color: dial.value == "–" ? Theme.placeholder : Theme.strong;
                                    font-family: Theme.write-font; font-size: Theme.dial-value-size; horizontal-alignment: center; vertical-alignment: center;
                                }
                                Text {
                                    x: Theme.calendar-gap; y: Theme.dial-top + row.dial-size + Theme.dial-label-gap; width: parent.width - Theme.calendar-gap * 2;
                                    text: dial.label; color: dial.selected ? Theme.text : Theme.muted; font-size: Theme.small-size; horizontal-alignment: center; overflow: elide;
                                }
                                dial-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    changed pressed => { root.dragging-dial = self.pressed; }
                                    property <bool> adjusted;
                                    moved => { if self.pressed && self.steps != 0 { self.adjusted = true; } }
                                    property <int> steps: round((self.pressed-y - self.mouse-y) / Theme.dial-drag-step);
                                    property <int> preview: clamp(dial.raw + self.steps, dial.low, dial.high);
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.adjusted = false; }
                                        if event.kind == PointerEventKind.up {
                                            if event.button == PointerEventButton.right { root.dial-set(dial.item, 0, true); }
                                            if event.button == PointerEventButton.left {
                                                if self.adjusted || self.steps != 0 { root.dial-set(dial.item, self.preview, false); }
                                                else { root.dial-point(dial.item, self.mouse-x - parent.width / 2, self.mouse-y - Theme.dial-top - row.dial-size / 2); }
                                            }
                                        }
                                    }
                                    scroll-event(event) => { root.dial-wheel(dial.item, event.delta-y); accept }
                                }
                                if dial.value != "–": Image {
                                    x: parent.width - self.width - Theme.calendar-gap; y: Theme.calendar-gap; width: Theme.day-tag-icon-size - 2px; height: self.width;
                                    source: JournalIcons.undo-icon; colorize: Theme.placeholder;
                                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dial-set(dial.item, 0, true); } }
                                }
                            }
                        }
                        if row.kind == 3 || row.kind == 6: DayActivity {
                            data: row; icon-play: root.icon-play; icon-pause: root.icon-pause; icon-stop: root.icon-stop;
                            clicked(item, part) => { root.day-click(item, part); }
                        }
                    }
                }
            }
        }
        // Whatever is left: the footer stays at the bottom.
        Rectangle { vertical-stretch: 0.0001; min-height: 0px; }
        Footer {
            label: root.footer-label; date: root.footer-date;
            menu-open: root.menu-open && root.app-menu; menu-label: root.footer-menu-label;
            menu => { root.app-menu-clicked(); }
            toast: root.notice; toast-is-error: root.notice-is-error;
            hints: root.footer-hints;
            success-icon: root.icon-success; error-icon: root.icon-error;
            action(which) => { root.footer-action(which); }
        }
    }
    // The one input of the form, laid over the active field: in the top line for the title, else on its line.
    input-area := Rectangle {
        x: root.in-header ? root.title-x : root.cell-x(root.active-cell) + Theme.field-inset;
        y: root.in-header ? 0px : Theme.line-height + Theme.border-width + Theme.gap / 2 + root.active-line * Theme.form-row-height;
        width: !root.editable ? Theme.idle-input-width : root.in-header ? root.title-width : root.cell-width(root.active-cell, root.active-multi) - Theme.field-inset * 2;
        height: root.in-header ? Theme.line-height : Theme.form-row-height;
        visible: root.entry-open && !root.notepad-open;
        opacity: root.editable ? 1 : 0;
        clip: true;
        if input.text == "" && root.editable: Text {
            width: parent.width; height: parent.height; vertical-alignment: center;
            text: root.in-header ? root.title-hint : root.placeholder; color: root.in-header && root.title-error ? Theme.error.with-alpha(0.7) : Theme.placeholder;
            font-family: root.in-header || root.active == 8 || root.active-multi ? Theme.write-font : Theme.ui-font;
            font-size: root.in-header ? Theme.search-size : Theme.write-size;
        }
        input := TextInput {
            height: parent.height;
            width: max(parent.width, self.preferred-width);
            vertical-alignment: center;
            color: Theme.strong;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.strong;
            font-family: root.in-header || root.active == 8 || root.active-multi ? Theme.write-font : Theme.ui-font;
            font-size: root.in-header ? Theme.search-size : Theme.write-size;
            single-line: true;
            edited => { root.edited(self.text); }
            cursor-position-changed(pos) => {
                if pos.x + self.x < 0px { self.x = -pos.x; }
                if pos.x + self.x > input-area.width - Theme.gap { self.x = input-area.width - Theme.gap - pos.x; }
            }
            key-pressed(raw-event) => {
                let event = KeyBindings.translate(ShortcutContext.form, raw-event);
                if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
                // The list of the types, while open: ↑/↓ choose, Enter, Esc or Backspace close it.
                if root.type-list-open {
                    if event.text == Key.UpArrow { root.form-key(21 + Math.mod(root.type-selected + 3, 4), 4); return accept; }
                    if event.text == Key.DownArrow { root.form-key(21 + Math.mod(root.type-selected + 1, 4), 4); return accept; }
                    if event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace { root.type-list-open = false; return accept; }
                }
                // On the type: Enter or Alt+↓ lists them.
                if root.active == 0 && ((event.text == Key.Return && !event.modifiers.control && !event.modifiers.shift) || (event.text == Key.DownArrow && event.modifiers.alt)) {
                    root.type-list-open = true; return accept;
                }
                if event.text == Key.F6 { root.form-key(15, 0); return accept; }
                if event.text == Key.Tab || event.text == Key.Backtab { root.form-key(0, root.mods(event.modifiers.shift || event.text == Key.Backtab, event.modifiers.control, event.modifiers.alt)); return accept; }
                if event.text == Key.UpArrow { root.form-key(1, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt)); return accept; }
                if event.text == Key.DownArrow { root.form-key(2, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt)); return accept; }
                if event.text == Key.Return { root.form-key(3, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt)); return accept; }
                if event.text == Key.Escape { root.type-list-open = false; root.form-key(4, 0); return accept; }
                // The arrows belong to the field's switch or its options (with their modifiers).
                if !root.native-arrows && event.text == Key.LeftArrow { root.form-key(5, root.mods(event.modifiers.shift, event.modifiers.control, false)); return accept; }
                if !root.native-arrows && event.text == Key.RightArrow { root.form-key(6, root.mods(event.modifiers.shift, event.modifiers.control, false)); return accept; }
                if !root.editable {
                    if event.text == Key.Insert { root.form-key(11, 0); return accept; }
                    if event.text == Key.Delete || event.text == Key.Backspace { root.form-key(12, 0); return accept; }
                    if event.text == Key.PageUp { root.form-key(7, root.mods(event.modifiers.shift, false, false)); return accept; }
                    if event.text == Key.PageDown { root.form-key(8, root.mods(event.modifiers.shift, false, false)); return accept; }
                    if event.text == Key.Home || (root.cal-focus && (event.text == "h" || event.text == "H")) { root.form-key(9, 0); return accept; }
                    if event.text == " " { root.form-key(10, 0); return accept; }
                    if !event.modifiers.alt && event.text >= "0" && event.text <= "9" { root.form-key(20 + event.text.to-float(), 0); return accept; }
                }
                if event.modifiers.control {
                    if event.text == "z" || event.text == "Z" { root.form-key(50, 0); return accept; }
                    if event.text == "y" || event.text == "Y" { root.form-key(51, 0); return accept; }
                    if event.text == "q" || event.text == "Q" { root.form-key(52, 0); return accept; }
                    return reject;
                }
                if event.modifiers.alt {
                    if event.text >= "1" && event.text <= "4" { root.type-list-open = false; root.form-key(20 + event.text.to-float(), 4); }
                    // Important, and the description, the reminder and the icon.
                    if event.text == "p" || event.text == "P" { root.form-key(30, 4); }
                    if event.text == "b" || event.text == "B" { root.form-key(31, 4); }
                    if event.text == "r" || event.text == "R" { root.form-key(32, 4); }
                    if event.text == "i" || event.text == "I" { root.form-key(33, 4); }
                    return accept;
                }
                if !root.editable { return accept; }
                reject
            }
        }
    }
    // The four types, listed under the type in the top line.
    if root.entry-open && root.type-list-open: Rectangle {
        x: type-chip.x + type-chip.width - self.width; y: Theme.line-height - Theme.calendar-gap;
        width: Theme.popover-width * 0.6; height: type-list.preferred-height;
        background: Theme.popover-background; border-radius: Theme.popover-radius;
        border-width: Theme.border-width; border-color: Theme.popover-border;
        drop-shadow-blur: Theme.popover-shadow-blur; drop-shadow-color: Theme.popover-shadow; drop-shadow-offset-y: 6px;
        type-list := VerticalLayout {
            padding: Theme.popover-padding; spacing: Theme.choice-spacing;
            for name[n] in root.type-names: Rectangle {
                height: Theme.side-row-height;
                border-radius: Theme.list-radius;
                background: n == root.type-selected ? Theme.row-selection : kind-touch.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: Theme.popover-inset; padding-right: Theme.popover-inset; spacing: Theme.gap;
                    Image { width: Theme.label-icon-size; height: self.width; y: (parent.height - self.height) / 2; source: root.type-icons[n]; colorize: n == root.type-selected ? Theme.strong : Theme.muted; }
                    Text { text: name; color: Theme.strong; font-size: Theme.row-size; vertical-alignment: center; horizontal-stretch: 1; }
                    KeyCaps { caps: ["Alt", "\{n + 1}"]; }
                }
                kind-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.form-key(21 + n, 4); root.type-list-open = false; input.focus(); } }
            }
        }
    }
    // The actions (Strg+K) and an entry's pickers: a card over the footer at the right; a click beside it closes it.
    if root.menu-open || root.side-open: TouchArea {
        x: 0px; y: 0px; width: root.form-space; height: root.pane-height;
        clicked => { root.toggle-menu(); }
    }
    if root.menu-open || root.side-open: ActionPopover {
        width: min(root.menu-open && root.app-menu ? Theme.app-menu-width : Theme.popover-width, root.form-space - Theme.gap * 2);
        x: root.menu-open && root.app-menu ? Theme.gap : root.form-space - self.width - Theme.gap;
        y: root.pane-height - Theme.footer-height - self.height - Theme.calendar-gap;
        menu-open: root.menu-open; app-menu: root.menu-open && root.app-menu;
        menu-title: root.menu-title; menu-rows: root.menu-rows; menu-pick: root.menu-pick;
        menu-placeholder: root.menu-placeholder; menu-empty: root.menu-empty;
        menu-edited(text) => { root.menu-edited(text); }
        menu-key(text, mods) => { root.menu-key(text, mods); }
        menu-choose(index) => { root.menu-choose(index); }
        side-open: root.side-open; side-kind: root.side-kind; side-title: root.side-title; side-heading: root.side-heading;
        side-heading-icon: root.side-heading-icon; side-rows: root.side-rows; side-focus-index: root.side-focus-index;
        side-clock-hours: root.side-clock-hours; side-clock-minutes: root.side-clock-minutes; side-clock-on-minutes: root.side-clock-on-minutes;
        side-month-title: root.side-month-title; side-weekdays: root.side-weekdays; side-cells: root.side-cells;
        side-confirm-text: root.side-confirm-text; side-text: root.side-text; side-placeholder: root.side-placeholder;
        icon-back: root.icon-back; icon-forward: root.icon-forward; focus-request: root.popover-focus;
        side-choose(index) => { root.side-choose(index); }
        side-edited(text) => { root.side-edited(text); }
        side-day(index) => { root.side-day(index); }
        side-month(by) => { root.side-month(by); }
        side-confirm => { root.side-confirm(); }
        side-back => { root.side-back(); }
        side-clock(minutes, steps) => { root.side-clock(minutes, steps); }
        day-key(text, mods) => { root.day-key(text, mods); }
    }
    Rectangle {
        x: root.stacked ? 0px : root.form-space;
        y: root.stacked ? root.pane-height : 0px;
        width: root.stacked ? root.content-width : Theme.border-width;
        height: root.stacked ? Theme.border-width : root.pane-height;
        background: Theme.divider;
    }
    calendar := Calendar {
        x: root.stacked ? 0px : root.form-space + Theme.border-width;
        y: root.stacked ? root.pane-height + Theme.border-width : 0px;
        width: root.stacked ? root.content-width : root.content-width - self.x;
        height: root.calendar-height;
        bands: root.cal-bands;
        blocks: root.cal-blocks;
        chips: root.cal-chips;
        lanes: root.cal-lanes;
        ticks: root.cal-ticks;
        time-x: root.cal-time-x;
        title: root.cal-title;
        icon: root.cal-icon;
        has-now: root.cal-has-now;
        now-x: root.cal-now-x;
        now-y: root.cal-now-y;
        now-h: root.cal-now-h;
        has-caret: root.cal-has-caret;
        caret-x: root.cal-caret-x;
        caret-y: root.cal-caret-y;
        caret-w: root.cal-caret-w;
        caret-h: root.cal-caret-h;
        focused: root.cal-focus;
        mouse(button, kind, x, y, shift) => { root.cal-mouse(button, kind, x, y, shift); }
        hover(active, x, y) => {
            if !active {
                if root.preview-target.source == 3 { root.leave-preview(3, root.preview-target.index); }
            } else {
                let target = root.calendar-hover-preview(x, y);
                root.hover-preview({ source: target.source, index: target.index, title: target.title, description: target.description,
                    x: self.absolute-position.x + target.x, y: self.absolute-position.y + target.y });
            }
        }
        wheel(x, delta, ctrl, shift) => { root.cal-wheel(x, delta, ctrl, shift); }
    }
    }
    }
    day-scope := FocusScope {
        width: 0px; height: 0px;
        key-pressed(raw-event) => {
            let event = KeyBindings.translate(root.side-open ? ShortcutContext.side : ShortcutContext.day, raw-event);
            if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
            root.day-key(event.text, root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt));
            accept
        }
    }
    if root.entry-preview-title != "": preview-card := Rectangle {
        property <length> pad: Theme.preview-padding;
        property <length> anchor-x: clamp(root.preview-target.x, Theme.popover-inset, root.width - Theme.popover-inset);
        property <length> anchor-y: clamp(root.preview-target.y, Theme.popover-inset, root.height - Theme.popover-inset);
        property <bool> below: self.anchor-y + Theme.preview-tail + self.height <= root.height - Theme.popover-inset;
        width: min(root.width - Theme.popover-inset * 2, Theme.popover-width,
            max(title-measure.preferred-width, body-measure.preferred-width) + self.pad * 2 + Theme.gap);
        height: min(Theme.entry-preview-max-height, root.height - Theme.popover-inset * 2, scroll.content-height + self.pad * 2);
        x: clamp(self.anchor-x - self.pad * 2, Theme.popover-inset, root.width - self.width - Theme.popover-inset);
        y: clamp(self.below ? self.anchor-y + Theme.preview-tail : self.anchor-y - Theme.preview-tail - self.height,
            Theme.popover-inset, root.height - self.height - Theme.popover-inset);
        background: Theme.popover-background;
        border-width: Theme.border-width; border-color: Theme.popover-border; border-radius: Theme.popover-radius;
        drop-shadow-blur: Theme.popover-shadow-blur; drop-shadow-color: Theme.popover-shadow;
        Rectangle {
            x: parent.anchor-x - parent.x - self.width / 2; width: Theme.focus-ring;
            y: parent.below ? -self.height : parent.height; height: Theme.preview-tail;
            background: Theme.accent;
            Rectangle { width: Theme.preview-pin; height: self.width; x: (parent.width - self.width) / 2;
                y: preview-card.below ? -self.height / 2 : parent.height - self.height / 2;
                border-radius: self.width / 2; background: Theme.accent; }
        }
        title-measure := Text { visible: false; text: root.entry-preview-title; font-size: Theme.row-size; font-weight: Theme.weight-semibold; }
        body-measure := StyledText { visible: false; text: root.preview-body(root.entry-preview-description);
            default-font-family: Theme.ui-font; default-font-size: Theme.small-size; }
        TouchArea {
            changed has-hover => {
                root.over-preview = self.has-hover;
                if self.has-hover { leave-delay.running = false; }
                else if !root.keyboard-preview { leave-delay.running = true; }
            }
            scroll := Flickable {
                x: Theme.preview-padding; y: self.x; width: parent.width - self.x * 2;
                height: parent.height - self.y * 2; content-width: self.width;
                content-y <=> root.preview-scroll-y;
                content-height: title.height + (root.entry-preview-description == "" ? 0px : Theme.gap + body.preferred-height);
                interactive: self.content-height > self.height;
                property <int> step: root.preview-scroll-step;
                property <int> last-step;
                init => { self.last-step = self.step; }
                changed step => {
                    self.content-y = clamp(self.content-y + (self.last-step - self.step) * self.height, min(0px, self.height - self.content-height), 0px);
                    self.last-step = self.step;
                }
                property <EntryPreview> target: root.preview-target;
                changed target => { self.content-y = 0px; }
                title := Text { x: 0px; y: 0px; width: scroll.width; height: self.preferred-height; text: root.entry-preview-title;
                    color: Theme.strong; font-size: Theme.row-size; font-weight: Theme.weight-semibold; wrap: word-wrap; }
                body := StyledText { x: 0px; y: title.height + Theme.gap; width: scroll.width; height: self.preferred-height;
                    text: body-measure.text; default-color: Theme.text; link-color: Theme.accent;
                    default-font-family: Theme.ui-font; default-font-size: Theme.small-size; }
            }
            if scroll.content-height > scroll.height: Rectangle { width: Theme.focus-ring; x: parent.width - Theme.popover-padding;
                height: max(Theme.gap, scroll.height * scroll.height / scroll.content-height);
                y: scroll.y - (scroll.height - self.height) * (scroll.content-y / (scroll.content-height - scroll.height));
                border-radius: self.width; background: Theme.muted; }
        }
    }
    // The outline where Windows draws none (its own corners and edge replace it where it can).
    Rectangle {
        border-radius: Theme.radius;
        border-color: Theme.background;
        border-width: Theme.frame-inset + Theme.frame-stroke;
    }
    Rectangle {
        x: Theme.frame-inset;
        y: Theme.frame-inset;
        width: parent.width - 2 * Theme.frame-inset;
        height: parent.height - 2 * Theme.frame-inset;
        border-radius: Theme.radius - Theme.frame-inset;
        border-color: Theme.border;
        border-width: Theme.frame-stroke;
    }
    }
}
