import { Theme } from "theme.slint";

// An icon of the tag editor's grid (the first is "no icon").
export struct TagIcon { has-icon: bool, icon: image, label: string, selected: bool }

// The tag editor (a tag was just made in a picker): its name, its colour as in the Journal app's colour picker (a field
// of saturation and brightness, a hue bar, the swatches, the hex code) and its icon. Tab goes through the parts, the
// arrows move in them, Enter keeps it, Esc leaves the tag as it was made. The model is `src/tag_edit.rs`.
export global TagEditorUi {
    in-out property <bool> open;
    in property <string> heading;
    in property <string> name-label;
    in property <string> color-label;
    in property <string> icon-label;
    in property <string> icon-placeholder;
    in property <string> name;
    in property <float> hue;
    in property <float> saturation;
    in property <float> value;
    in property <color> color;
    in property <string> hex;
    in property <[color]> swatches;
    in property <int> swatch: -1;
    in property <[TagIcon]> icons;
    in property <string> icon-name;
    in property <int> icon-pick;
    in property <string> error;
    // 0 name, 1 field, 2 swatches, 3 hex, 4 icons.
    in property <int> part;
    // Each change of the text inputs' text from Rust (a new tag) is counted here.
    in property <int> reset;
    callback name-edited(string);
    callback field(float, float);
    callback hue-at(float);
    callback pick-swatch(int);
    callback hex-edited(string);
    callback query-edited(string);
    callback pick-icon(int);
    callback focus-part(int);
    // Tab, the arrows (with Shift), Enter and Esc.
    callback key(string, bool);
}

component Knob inherits Rectangle {
    width: Theme.tag-knob; height: self.width; border-radius: self.width / 2;
    border-width: Theme.tag-knob-ring; border-color: Theme.tag-knob-light;
    drop-shadow-blur: Theme.tag-knob-ring; drop-shadow-color: Theme.tag-knob-shadow;
}

// The keys an input hands to the editor: everything that moves between the parts, keeps or leaves.
component EditorInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> active;
    in property <bool> arrows-up-down;
    in property <int> reset;
    callback edited(string);
    callback focused();
    public function grab() { input.focus(); input.select-all(); }
    height: Theme.popover-search-height;
    background: Theme.field-background; border-radius: Theme.field-radius;
    border-width: Theme.border-width; border-color: root.active ? Theme.field-focus : Theme.edge;
    changed reset => { input.text = root.text; }
    // A value changed elsewhere (the hex by the field or a swatch) shows while the input is not being written in.
    changed text => { if !input.has-focus { input.text = root.text; } }
    if input.text == "": Text { x: input.x; height: parent.height; text: root.placeholder; color: Theme.placeholder; font-size: Theme.row-size; vertical-alignment: center; }
    input := TextInput {
        x: Theme.field-inset; width: parent.width - 2 * Theme.field-inset; height: parent.height;
        text: root.text; single-line: true; vertical-alignment: center; color: Theme.strong; font-size: Theme.row-size;
        selection-background-color: Theme.selection; selection-foreground-color: Theme.strong;
        changed has-focus => { if self.has-focus { root.focused(); } }
        edited => { root.edited(self.text); }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.Return || event.text == Key.Escape
                || (root.arrows-up-down && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                TagEditorUi.key(event.text == Key.Backtab ? Key.Tab : event.text, event.modifiers.shift || event.text == Key.Backtab);
                return accept;
            }
            reject
        }
    }
}

export component TagEditor inherits Rectangle {
    // The window behind is quiet; a click there leaves the tag as it is.
    background: Theme.tag-editor-backdrop;
    TouchArea { clicked => { TagEditorUi.key(Key.Escape, false); } }
    property <int> part: TagEditorUi.part;
    changed part => { root.take-focus(); }
    property <bool> shown: TagEditorUi.open;
    changed shown => { if self.shown { root.take-focus(); } }
    init => { root.take-focus(); }
    function take-focus() {
        if TagEditorUi.part == 0 { name-input.grab(); }
        else if TagEditorUi.part == 3 { hex-input.grab(); }
        else if TagEditorUi.part == 4 { icon-input.grab(); }
        else { keys.focus(); }
    }
    card := Rectangle {
        width: min(Theme.tag-editor-width, root.width - 2 * Theme.gap);
        height: min(layout.preferred-height, root.height - 2 * Theme.gap);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.popover-background; border-radius: Theme.popover-radius;
        border-width: Theme.border-width; border-color: Theme.popover-border;
        drop-shadow-blur: Theme.popover-shadow-blur; drop-shadow-color: Theme.popover-shadow;
        clip: true;
        TouchArea {}
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.Return || event.text == Key.Escape
                    || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    TagEditorUi.key(event.text == Key.Backtab ? Key.Tab : event.text, event.modifiers.shift || event.text == Key.Backtab);
                    return accept;
                }
                reject
            }
        }
        layout := VerticalLayout {
            padding: Theme.tag-editor-padding; spacing: Theme.gap;
            HorizontalLayout {
                spacing: Theme.gap;
                Rectangle { width: Theme.tag-dot * 1.5; height: self.width; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: TagEditorUi.color; }
                Text { text: TagEditorUi.heading; color: Theme.strong; font-size: Theme.row-size; font-weight: Theme.weight-semibold; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Text { text: TagEditorUi.name-label; color: Theme.muted; font-size: Theme.section-size; }
            name-input := EditorInput {
                text: TagEditorUi.name; placeholder: TagEditorUi.name-label; active: TagEditorUi.part == 0; reset: TagEditorUi.reset;
                edited(text) => { TagEditorUi.name-edited(text); }
                focused => { if TagEditorUi.part != 0 { TagEditorUi.focus-part(0); } }
            }
            Text { text: TagEditorUi.color-label; color: Theme.muted; font-size: Theme.section-size; }
            // Saturation from left to right, brightness from bottom to top, in the hue chosen.
            field := Rectangle {
                height: Theme.tag-field-height; border-radius: Theme.block-radius; clip: true;
                border-width: TagEditorUi.part == 1 ? Theme.border-width : 0px; border-color: Theme.field-focus;
                background: hsv(TagEditorUi.hue, 1, 1);
                Rectangle { background: @linear-gradient(90deg, Theme.tag-knob-light 0%, Theme.tag-knob-light.with-alpha(0) 100%); }
                Rectangle { background: @linear-gradient(180deg, Theme.tag-field-dark.with-alpha(0) 0%, Theme.tag-field-dark 100%); }
                Knob { x: TagEditorUi.saturation * parent.width - self.width / 2; y: (1 - TagEditorUi.value) * parent.height - self.height / 2; background: TagEditorUi.color; }
                TouchArea {
                    mouse-cursor: crosshair;
                    pointer-event(event) => { if event.kind == PointerEventKind.down { TagEditorUi.field(self.mouse-x / self.width, self.mouse-y / self.height); } }
                    moved => { if self.pressed { TagEditorUi.field(self.mouse-x / self.width, self.mouse-y / self.height); } }
                }
            }
            // The hue.
            Rectangle {
                height: Theme.tag-hue-height; border-radius: self.height / 2;
                background: @linear-gradient(90deg, hsv(0, 1, 1) 0%, hsv(60, 1, 1) 16.67%, hsv(120, 1, 1) 33.33%, hsv(180, 1, 1) 50%, hsv(240, 1, 1) 66.67%, hsv(300, 1, 1) 83.33%, hsv(360, 1, 1) 100%);
                Knob { x: TagEditorUi.hue / 360 * parent.width - self.width / 2; y: (parent.height - self.height) / 2; background: hsv(TagEditorUi.hue, 1, 1); }
                TouchArea {
                    pointer-event(event) => { if event.kind == PointerEventKind.down { TagEditorUi.hue-at(max(0, min(1, self.mouse-x / self.width)) * 360); } }
                    moved => { if self.pressed { TagEditorUi.hue-at(max(0, min(1, self.mouse-x / self.width)) * 360); } }
                }
            }
            // The app's swatches.
            HorizontalLayout {
                spacing: Theme.calendar-gap; alignment: space-between;
                for swatch[i] in TagEditorUi.swatches: Rectangle {
                    width: Theme.tag-swatch; height: self.width; border-radius: self.width / 2; background: swatch;
                    border-width: TagEditorUi.swatch == i ? Theme.tag-knob-ring : 0px;
                    border-color: TagEditorUi.part == 2 ? Theme.field-focus : Theme.strong;
                    TouchArea { mouse-cursor: pointer; clicked => { TagEditorUi.pick-swatch(i); } }
                }
            }
            hex-input := EditorInput {
                text: TagEditorUi.hex; placeholder: "#rrggbb"; active: TagEditorUi.part == 3; reset: TagEditorUi.reset;
                edited(text) => { TagEditorUi.hex-edited(text); }
                focused => { if TagEditorUi.part != 3 { TagEditorUi.focus-part(3); } }
            }
            HorizontalLayout {
                spacing: Theme.gap;
                Text { text: TagEditorUi.icon-label; color: Theme.muted; font-size: Theme.section-size; vertical-alignment: center; }
                Text { text: TagEditorUi.icon-name; color: Theme.text; font-size: Theme.small-size; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
            }
            icon-input := EditorInput {
                text: ""; placeholder: TagEditorUi.icon-placeholder; active: TagEditorUi.part == 4; arrows-up-down: true; reset: TagEditorUi.reset;
                edited(text) => { TagEditorUi.query-edited(text); }
                focused => { if TagEditorUi.part != 4 { TagEditorUi.focus-part(4); } }
            }
            icon-grid := Flickable {
                height: min(Theme.tag-icon-rows * Theme.side-icon-cell, Math.ceil(TagEditorUi.icons.length / Theme.side-icon-columns) * Theme.side-icon-cell);
                content-height: Math.ceil(TagEditorUi.icons.length / Theme.side-icon-columns) * Theme.side-icon-cell;
                property <length> grid-x: (self.width - Theme.side-icon-columns * Theme.side-icon-cell) / 2;
                // The chosen icon's line stays in view.
                property <length> pick-top: Math.floor(TagEditorUi.icon-pick / Theme.side-icon-columns) * Theme.side-icon-cell;
                changed pick-top => { self.content-y = min(0px, max(min(self.content-y, -self.pick-top), self.height - self.pick-top - Theme.side-icon-cell)); }
                for line[i] in TagEditorUi.icons: Rectangle {
                    x: parent.grid-x + Math.mod(i, Theme.side-icon-columns) * Theme.side-icon-cell;
                    y: Math.floor(i / Theme.side-icon-columns) * Theme.side-icon-cell;
                    width: Theme.side-icon-cell - Theme.calendar-gap; height: self.width;
                    border-radius: Theme.block-radius;
                    background: Theme.row-fill(line.selected, touch.has-hover, touch.pressed);
                    border-width: line.selected && TagEditorUi.part == 4 ? Theme.border-width : 0px; border-color: Theme.field-focus;
                    if line.has-icon: Image { width: Theme.icon-size; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: line.icon; colorize: line.selected ? TagEditorUi.color : Theme.muted; }
                    if !line.has-icon: Text { text: "–"; color: Theme.muted; font-size: Theme.row-size; horizontal-alignment: center; vertical-alignment: center; }
                    touch := TouchArea { mouse-cursor: pointer; clicked => { TagEditorUi.pick-icon(i); } }
                }
            }
            if TagEditorUi.error != "": Text { text: TagEditorUi.error; color: Theme.error; font-size: Theme.small-size; wrap: word-wrap; }
        }
    }
}
