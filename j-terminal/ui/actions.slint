import { Theme } from "theme.slint";
import { KeyBindings, ShortcutContext } from "key-bindings.slint";
import { KeyCaps } from "footer.slint";
import { JournalIcons } from "journal-icons.slint";

// A line of the actions (Strg+K): `section` names the group it begins, `caps` are its keys.
export struct MenuRow { top: length, section: string, has-icon: bool, icon: image, label: string, value: string, caps: [string], on: bool, danger: bool, has-color: bool, color: color }
// A line of a picker (a tag, a reminder, an icon) and a day of the planning month.
export struct SideRow { has-icon: bool, icon: image, label: string, value: string, selected: bool, on: bool, has-color: bool, color: color, danger: bool }
export struct MonthCell { label: string, in-month: bool, today: bool, cursor: bool, picked: bool, own: bool, pending: bool, disabled: bool }

// The search under the list: typing filters, the keys that move or choose are handed on.
component PopoverSearch inherits Rectangle {
    in property <string> placeholder;
    in property <string> initial;
    in property <int> focus-request;
    // The actions' keys (Enter, ↑/↓, Esc, Tab) or a picker's (also ←/→ while empty, Strg+Entf).
    in property <bool> menu;
    // ←/→ belong to the list (the icon grid), not to the text.
    in property <bool> sideways;
    // Above the list (the compact card): the dividing line below it.
    in property <bool> on-top;
    callback edited(string);
    callback hand-on(string, int);
    pure function mods(shift: bool, control: bool, alt: bool) -> int { return (shift ? 1 : 0) + (control ? 2 : 0) + (alt ? 4 : 0); }
    changed focus-request => { if root.visible { input.focus(); } }
    public function reset() { input.text = ""; }
    public function grab() { input.focus(); }
    Rectangle { y: root.on-top ? parent.height - Theme.border-width : 0px; height: Theme.border-width; background: Theme.divider; }
    Image {
        x: Theme.popover-inset + Theme.popover-padding;
        y: (parent.height - self.height) / 2; width: Theme.label-icon-size; height: self.width;
        source: JournalIcons.search-icon; colorize: Theme.muted;
    }
    TouchArea { mouse-cursor: text; clicked => { input.focus(); } }
    if input.text == "": Text {
        x: input.x; width: input.width; height: parent.height;
        text: root.placeholder; color: Theme.placeholder; font-size: Theme.row-size; vertical-alignment: center;
    }
    input := TextInput {
        x: Theme.popover-inset + Theme.popover-padding + Theme.label-icon-size + Theme.gap;
        width: parent.width - self.x - Theme.popover-inset; height: parent.height;
        accessible-label: root.placeholder;
        text: root.initial; single-line: true; vertical-alignment: center;
        color: Theme.strong; font-size: Theme.row-size;
        selection-background-color: Theme.selection; selection-foreground-color: Theme.strong;
        init => { if root.visible { self.focus(); } }
        edited => { root.edited(self.text); }
        key-pressed(raw-event) => {
            let event = KeyBindings.translate(root.menu ? ShortcutContext.window : ShortcutContext.side, raw-event);
            if event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt || event.text == Key.Meta { return reject; }
            let mods = root.mods(event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            if event.text == Key.Return || event.text == Key.Escape || event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.Tab || event.text == Key.Backtab
                || (root.menu && self.text == "" && (event.text == Key.Home || event.text == Key.End)) {
                root.hand-on(event.text, mods);
                return accept;
            }
            // Backspace in an empty search: one step back (out of a picker, or the actions closed).
            if event.text == Key.Backspace && self.text == "" && !event.modifiers.control && !event.modifiers.alt {
                root.hand-on(Key.Escape, 0);
                return accept;
            }
            if !root.menu && (((event.modifiers.control || event.modifiers.alt) && event.text == Key.Delete) || ((event.text == Key.LeftArrow || event.text == Key.RightArrow) && (root.sideways || self.text == ""))) {
                root.hand-on(event.text, mods);
                return accept;
            }
            reject
        }
    }
}

// The actions behind Strg+K, as Raycast's action panel: a card over the footer at the right, a short list with
// sections, each action's keys at its right, the search under it. The pickers of an entry (tags, icons, reminders,
// the clock, a month to plan on, the description) open in the same card; Esc goes back to the list.
export component ActionPopover inherits Rectangle {
    // The list of actions.
    in property <bool> menu-open;
    in property <bool> app-menu;
    in property <string> menu-title;
    in property <[MenuRow]> menu-rows;
    in property <int> menu-pick;
    in property <string> menu-placeholder;
    in property <string> menu-empty;
    callback menu-edited(string);
    callback menu-key(string, int);
    callback menu-choose(int);
    // A picker.
    in property <bool> side-open;
    in property <int> side-kind;
    in property <string> side-title;
    in property <string> side-heading;
    in property <image> side-heading-icon;
    in property <[SideRow]> side-rows;
    in property <int> side-focus-index: -1;
    in property <string> side-clock-hours;
    in property <string> side-clock-minutes;
    in property <bool> side-clock-on-minutes;
    in property <string> side-month-title;
    in property <[string]> side-weekdays;
    in property <[MonthCell]> side-cells;
    in property <string> side-confirm-text;
    in property <string> side-text;
    in property <string> side-placeholder;
    in property <image> icon-back;
    in property <image> icon-forward;
    in property <int> focus-request;
    callback side-choose(int);
    // The icon grid was scrolled: its first line in sight (the window draws only the icons near it).
    callback side-scrolled(int);
    callback side-edited(string);
    callback side-day(int);
    callback side-month(int);
    callback side-confirm();
    callback side-back();
    callback side-clock(bool, int);
    callback day-key(string, int);

    // Opened by a right click: smaller lines, the search on top, no keys.
    in property <bool> compact;
    private property <length> line-height: root.compact ? Theme.compact-row-height : Theme.side-row-height;
    private property <length> search-height: root.compact ? Theme.compact-search-height : Theme.popover-search-height;
    in property <bool> menu-can-back;
    in property <int> search-reset;
    changed search-reset => { search.reset(); if root.searching { search.grab(); } }
    private property <length> inner: self.width - Theme.popover-padding * 2;
    // As high as its content, at most the theme's height; the list scrolls inside.
    preferred-height: content.preferred-height;
    height: min(Theme.popover-max-height, content.preferred-height);
    background: Theme.popover-background;
    border-radius: Theme.popover-radius;
    border-width: Theme.border-width;
    border-color: Theme.popover-border;
    drop-shadow-blur: Theme.popover-shadow-blur;
    drop-shadow-color: Theme.popover-shadow;
    drop-shadow-offset-y: Theme.block-radius;
    clip: true;
    // Clicks inside stay inside.
    TouchArea {}

    content := VerticalLayout {
        // Room for the search when it is on top.
        if root.compact && root.searching: Rectangle { height: root.search-height; }
        // The heading: what the actions are about, or the picker's name (a click: back to the actions). The compact
        // card shows it only where it leads back.
        if !root.app-menu && (!root.compact || root.side-open || root.menu-can-back): Rectangle {
            height: Theme.section-height + Theme.popover-padding;
            HorizontalLayout {
                padding-left: Theme.popover-inset + Theme.popover-padding; padding-right: Theme.popover-inset; padding-top: Theme.popover-padding;
                spacing: Theme.gap; alignment: start;
                if root.side-open || root.menu-can-back: Image {
                    width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2;
                    source: root.icon-back; colorize: back-touch.has-hover ? Theme.strong : Theme.muted;
                }
                Text {
                    text: root.side-open ? root.side-heading : root.menu-title;
                    color: Theme.muted; font-size: Theme.section-size; font-weight: Theme.weight-medium;
                    vertical-alignment: center; overflow: elide;
                }
                if root.side-open && root.side-title != "": Text {
                    text: "· " + root.side-title; color: Theme.placeholder; font-size: Theme.section-size;
                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                }
            }
            back-touch := TouchArea {
                enabled: root.side-open || root.menu-can-back;
                mouse-cursor: default; clicked => { root.side-back(); }
            }
        }
        // ----- The actions -----
        if root.menu-open: menu-list := Flickable {
            // The chosen line stays in view (its place comes from Rust: the sections make the lines uneven).
            property <length> pick-top: root.menu-pick >= 0 && root.menu-pick < root.menu-rows.length ? root.menu-rows[root.menu-pick].top : 0px;
            property <length> list-limit: root.menu-rows.length > Theme.action-visible-rows
                ? root.menu-rows[Theme.action-visible-rows].top + root.line-height / 2
                : menu-lines.preferred-height;
            function reveal() {
                self.content-y = min(0px, max(min(self.content-y, -self.pick-top), self.height - self.pick-top - root.line-height - Theme.popover-padding));
            }
            changed pick-top => { self.reveal(); }
            changed height => { self.reveal(); }
            min-height: root.line-height;
            preferred-height: self.list-limit;
            max-height: self.list-limit;
            vertical-stretch: 1;
            content-height: menu-lines.preferred-height;
            menu-lines := VerticalLayout {
                padding-left: Theme.popover-padding; padding-right: Theme.popover-padding; padding-bottom: Theme.popover-padding;
                padding-top: root.app-menu || root.compact ? Theme.popover-padding : 0px;
                width: parent.width; height: self.preferred-height;
                spacing: Theme.choice-spacing;
                for row[i] in root.menu-rows: VerticalLayout {

                    if row.section != "" && i > 0: Rectangle {
                        height: Theme.gap + Theme.border-width;
                        Rectangle { y: Theme.gap / 2; height: Theme.border-width; background: Theme.divider; }
                    }
                    if row.section != "" && i > 0: HorizontalLayout {
                        padding-left: Theme.popover-inset;
                        Text {
                            height: Theme.section-height - Theme.gap; vertical-alignment: center;
                            text: row.section; color: Theme.muted; font-size: Theme.section-size; font-weight: Theme.weight-medium;
                        }
                    }
                    Rectangle {
                        height: root.line-height;
                        border-radius: Theme.list-radius;
                        background: Theme.row-fill(i == root.menu-pick, menu-touch.has-hover, menu-touch.pressed); animate background { duration: Theme.hover-time; }
                        accessible-role: list-item; accessible-label: row.label; accessible-item-selected: i == root.menu-pick;
                        accessible-action-default => { root.menu-choose(i); }
                        HorizontalLayout {
                            padding-left: Theme.popover-inset; padding-right: Theme.popover-inset; spacing: Theme.gap;
                            if row.has-icon: Image {
                                width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2; source: row.icon;
                                colorize: row.danger ? Theme.error : row.has-color ? row.color : row.on ? Theme.strong : Theme.muted;
                            }
                            Text {
                                text: row.label; color: row.danger ? Theme.error : Theme.strong; font-size: Theme.row-size;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                            if row.value != "": Text {
                                text: row.value; color: Theme.muted; font-size: Theme.small-size; vertical-alignment: center;
                                overflow: elide; max-width: Theme.side-value-width;
                            }
                            if row.on && row.value == "": Rectangle { width: Theme.tag-dot - 2px; height: self.width; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: Theme.strong; }
                            if !root.compact: KeyCaps { caps: row.caps; lit: i == root.menu-pick; }
                        }
                        menu-touch := TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.menu-choose(i); } }
                    }
                }
                if root.menu-rows.length == 0: Text {
                    height: root.line-height; vertical-alignment: center;
                    text: root.menu-empty; color: Theme.placeholder; font-size: Theme.row-size;
                }
            }
        }
        // ----- The pickers -----
        // Tags, reminders and deletion scopes.
        if root.side-open && (root.side-kind == 1 || root.side-kind == 3 || root.side-kind == 7): side-list := Flickable {
            min-height: root.line-height;
            preferred-height: side-lines.preferred-height;
            vertical-stretch: 1;
            property <int> focused-row: root.side-focus-index;
            changed focused-row => {
                if self.focused-row >= 0 {
                    let top = self.focused-row * (root.line-height + Theme.choice-spacing);
                    self.content-y = min(0px, max(min(self.content-y, -top), self.height - top - root.line-height));
                }
            }
            content-height: side-lines.preferred-height;
            side-lines := VerticalLayout {
                padding-left: Theme.popover-padding; padding-right: Theme.popover-padding; padding-bottom: Theme.popover-padding;
                width: parent.width; height: self.preferred-height;
                spacing: Theme.choice-spacing;
                for line[i] in root.side-rows: Rectangle {
                    height: root.line-height;
                    border-radius: Theme.list-radius;
                    background: Theme.row-fill(line.selected, line-touch.has-hover, line-touch.pressed); animate background { duration: Theme.hover-time; }
                    accessible-role: list-item; accessible-label: line.label; accessible-item-selected: line.selected;
                    accessible-action-default => { root.side-choose(i); }
                    HorizontalLayout {
                        padding-left: Theme.popover-inset; padding-right: Theme.popover-inset; spacing: Theme.gap;
                        if line.has-icon: Image { width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2; source: line.icon;
                            colorize: line.danger ? Theme.error : line.has-color ? line.color : line.on ? Theme.strong : Theme.muted; }
                        if !line.has-icon && line.has-color: Rectangle { width: Theme.tag-dot; height: Theme.tag-dot; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: line.color; }
                        Text { text: line.label; color: line.danger ? Theme.error : line.on || line.selected ? Theme.strong : Theme.text; font-size: Theme.row-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if line.value != "": Text { text: line.value; color: Theme.muted; font-size: Theme.small-size; vertical-alignment: center; overflow: elide; max-width: Theme.side-value-width; }
                        if line.on: Text { text: "✓"; color: Theme.strong; font-size: Theme.row-size; vertical-alignment: center; }
                    }
                    line-touch := TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-choose(i); } }
                }
            }
        }
        // Icons: a grid.
        if root.side-open && root.side-kind == 2: Flickable {
            height: min(Theme.popover-max-height - Theme.section-height - Theme.popover-search-height - Theme.popover-padding * 2,
                Math.ceil(root.side-rows.length / Theme.side-icon-columns) * Theme.side-icon-cell) + Theme.popover-padding;
            content-height: Math.ceil(root.side-rows.length / Theme.side-icon-columns) * Theme.side-icon-cell + Theme.popover-padding;
            property <length> grid-x: (self.width - Theme.side-icon-columns * Theme.side-icon-cell) / 2;
            // The chosen icon's line stays in view.
            property <length> focus-top: root.side-focus-index < 0 ? 0px : Math.floor(root.side-focus-index / Theme.side-icon-columns) * Theme.side-icon-cell;
            changed focus-top => { self.content-y = min(0px, max(min(self.content-y, -self.focus-top), self.height - self.focus-top - Theme.side-icon-cell)); }
            changed content-y => { root.side-scrolled(Math.floor(-self.content-y / Theme.side-icon-cell)); }
            for line[i] in root.side-rows: Rectangle {
                x: parent.grid-x + Math.mod(i, Theme.side-icon-columns) * Theme.side-icon-cell;
                y: Math.floor(i / Theme.side-icon-columns) * Theme.side-icon-cell;
                width: Theme.side-icon-cell - Theme.calendar-gap; height: Theme.side-icon-cell - Theme.calendar-gap;
                border-radius: Theme.block-radius;
                background: Theme.row-fill(line.selected, icon-touch.has-hover, icon-touch.pressed); animate background { duration: Theme.hover-time; }
                border-width: line.on ? Theme.border-width : 0px; border-color: Theme.field-focus;
                Image { width: Theme.icon-size; height: Theme.icon-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: line.icon; colorize: line.selected || line.on ? Theme.strong : Theme.muted; }
                icon-touch := TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-choose(i); } }
            }
        }
        // The clock: big hours and minutes; the wheel or ↑/↓ change the part with the arrows.
        if root.side-open && root.side-kind == 4: HorizontalLayout {
            alignment: center; spacing: Theme.gap; padding: Theme.popover-padding;
            Rectangle {
                width: side-hours.preferred-width + Theme.clock-inset * 2; height: Theme.clock-box-height;
                background: !root.side-clock-on-minutes ? Theme.row-selection : Theme.field-background; border-radius: Theme.block-radius;
                border-width: Theme.border-width; border-color: !root.side-clock-on-minutes ? Theme.field-focus : Theme.edge;
                side-hours := Text { text: root.side-clock-hours; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.strong; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-clock(false, 0); } scroll-event(event) => { root.side-clock(false, event.delta-y > 0 ? 1 : -1); accept } }
            }
            Text { text: ":"; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.muted; vertical-alignment: center; }
            Rectangle {
                width: side-minutes.preferred-width + Theme.clock-inset * 2; height: Theme.clock-box-height;
                background: root.side-clock-on-minutes ? Theme.row-selection : Theme.field-background; border-radius: Theme.block-radius;
                border-width: Theme.border-width; border-color: root.side-clock-on-minutes ? Theme.field-focus : Theme.edge;
                side-minutes := Text { text: root.side-clock-minutes; font-family: Theme.write-font; font-size: Theme.clock-size; color: Theme.strong; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-clock(true, 0); } scroll-event(event) => { root.side-clock(true, event.delta-y > 0 ? 1 : -1); accept } }
            }
        }
        // The month to plan on: the entry's own day quiet, today marked, the chosen day(s) in the accent.
        if root.side-open && root.side-kind == 5: HorizontalLayout {
            padding-left: Theme.popover-inset + Theme.popover-padding; padding-right: Theme.popover-inset + Theme.popover-padding;
            spacing: Theme.gap; height: Theme.side-row-height;
            Image { width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2; source: root.icon-back; colorize: Theme.muted;
                TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-month(-1); } } }
            Text { text: root.side-month-title; color: Theme.strong; font-size: Theme.row-size; font-weight: Theme.weight-medium; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
            Image { width: Theme.label-icon-size; height: Theme.label-icon-size; y: (parent.height - self.height) / 2; source: root.icon-forward; colorize: Theme.muted;
                TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-month(1); } } }
        }
        if root.side-open && root.side-kind == 5: Rectangle {
            height: Theme.side-cell * 7;
            property <length> grid-x: (self.width - Theme.side-cell * 7) / 2;
            for name[w] in root.side-weekdays: Text {
                x: parent.grid-x + w * Theme.side-cell; y: 0px; width: Theme.side-cell; height: Theme.side-cell;
                text: name; color: w >= 5 ? (w == 5 ? Theme.saturday : Theme.sunday) : Theme.placeholder; font-size: Theme.small-size; horizontal-alignment: center; vertical-alignment: center;
            }
            for cell[i] in root.side-cells: Rectangle {
                x: parent.grid-x + Math.mod(i, 7) * Theme.side-cell + Theme.side-cell-inset; y: (Math.floor(i / 7) + 1) * Theme.side-cell + Theme.side-cell-inset;
                width: Theme.side-cell - Theme.side-cell-inset * 2; height: Theme.side-cell - Theme.side-cell-inset * 2;
                border-radius: self.height / 2;
                background: cell.picked ? Theme.accent : cell.pending ? Theme.selection : cell.cursor ? Theme.row-selection : cell-touch.has-hover && !cell.disabled ? Theme.hover : transparent;
                border-width: cell.cursor || cell.today ? Theme.border-width : 0px; border-color: cell.cursor ? Theme.field-focus : Theme.accent;
                Text {
                    text: cell.label; font-family: Theme.write-font; font-size: Theme.row-size; horizontal-alignment: center; vertical-alignment: center;
                    color: cell.picked ? Theme.ground : cell.own || cell.disabled || !cell.in-month ? Theme.placeholder : cell.today ? Theme.accent : Theme.text;
                }
                cell-touch := TouchArea { enabled: !cell.disabled; mouse-cursor: MouseCursor.default; clicked => { root.side-day(i); } }
            }
        }
        // The clock's and the month's confirming line.
        if root.side-open && (root.side-kind == 4 || root.side-kind == 5): Rectangle {
            height: Theme.side-row-height + Theme.popover-padding * 2;
            if root.side-confirm-text != "": Rectangle {
                x: Theme.popover-padding; y: Theme.popover-padding; width: parent.width - Theme.popover-padding * 2; height: Theme.side-row-height;
                border-radius: Theme.list-radius;
                background: take-touch.has-hover ? Theme.row-selection-strong : Theme.row-selection;
                HorizontalLayout {
                    padding-left: Theme.popover-inset; padding-right: Theme.popover-inset; spacing: Theme.gap;
                    Text { text: root.side-confirm-text; color: Theme.strong; font-size: Theme.row-size; vertical-alignment: center; horizontal-stretch: 1; }
                    KeyCaps { caps: ["↵"]; }
                }
                take-touch := TouchArea { mouse-cursor: MouseCursor.default; clicked => { root.side-confirm(); } }
            }
        }
        if root.side-open && root.side-kind == 8: HorizontalLayout {
            padding:Theme.popover-padding;spacing:Theme.gap;height:Theme.popover-search-height;
            TextInput {text:root.side-text;single-line:true;color:Theme.strong;
                horizontal-stretch:1;vertical-alignment:center;init=>{self.focus();self.select-all();}
                // A following question (a link's title after its address) starts from its own value.
                property <int> reset:root.search-reset;
                changed reset=>{self.text=root.side-text;self.select-all();}
                edited=>{root.side-edited(self.text);}accepted=>{root.side-confirm();}}
            Rectangle {width:Theme.side-row-height;border-radius:Theme.list-radius;background:Theme.row-selection;
                Text {text:"↵";color:Theme.strong;horizontal-alignment:center;vertical-alignment:center;}
                TouchArea {mouse-cursor:default;clicked=>{root.side-confirm();}}}
        }
        // The description: written in place; Esc keeps it.
        if root.side-open && root.side-kind == 6: Rectangle {
            height: Theme.side-description-height + Theme.popover-padding;
            Rectangle {
                x: Theme.popover-padding; width: parent.width - Theme.popover-padding * 2; height: Theme.side-description-height;
                background: Theme.field-background; border-radius: Theme.field-radius;
                border-width: Theme.border-width; border-color: Theme.field-focus;
                if description.text == "": Text { x: Theme.field-inset; y: Theme.field-inset; text: root.side-placeholder; color: Theme.placeholder; font-size: Theme.write-size; font-family: Theme.write-font; }
                description := TextInput {
                    x: Theme.field-inset; y: Theme.field-inset; width: parent.width - Theme.field-inset * 2; height: parent.height - Theme.field-inset * 2;
                    text: root.side-text; single-line: false; wrap: word-wrap; color: Theme.strong; font-family: Theme.write-font; font-size: Theme.write-size;
                    selection-background-color: Theme.selection; selection-foreground-color: Theme.strong;
                    init => { self.focus(); }
                    edited => { root.side-edited(self.text); }
                    key-pressed(event) => {
                        if event.text == Key.Escape { root.day-key(event.text, 0); return accept; }
                        reject
                    }
                }
            }
        }
        // Room for the search at the bottom.
        Rectangle { height: !root.compact && root.searching ? root.search-height : 0px; }
    }
    // The search: of the actions, or of the tags and icons. One field that stays (and keeps the keyboard) while
    // the card goes from the actions into a picker and back; it starts empty each time. On top in the compact card.
    search := PopoverSearch {
        x: 0px; width: root.width; y: root.compact ? 0px : root.height - self.height;
        visible: root.searching; on-top: root.compact;
        height: root.searching ? root.search-height : 0px;
        placeholder: root.menu-open ? root.menu-placeholder : root.side-placeholder;
        menu: root.menu-open; sideways: !root.menu-open && root.side-kind == 2;
        focus-request: root.focus-request;
        edited(text) => { if root.menu-open { root.menu-edited(text); } else { root.side-edited(text); } }
        hand-on(text, mods) => { if root.menu-open { root.menu-key(text, mods); } else { root.day-key(text, mods); } }
    }
    if root.menu-open && root.app-menu: FocusScope {
        width: 0px; height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace {
                root.menu-key(event.text == Key.Backspace ? Key.Escape : event.text, 0);
                return accept;
            }
            reject
        }
    }
    private property <bool> searching: (root.menu-open && !root.app-menu) || (root.side-open && (root.side-kind == 1 || root.side-kind == 2));
    private property <int> mode: root.menu-open ? 0 : root.side-open ? root.side-kind : -1;
    changed mode => { search.reset(); if root.searching { search.grab(); } }
}
