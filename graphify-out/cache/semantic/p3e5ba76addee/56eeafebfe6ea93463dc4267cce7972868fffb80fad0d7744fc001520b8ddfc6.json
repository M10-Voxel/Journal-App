{"nodes": [{"id": "readme_journal", "label": "Journal Windows application", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_tauri", "label": "Tauri 2", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_react", "label": "React", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_typescript", "label": "TypeScript", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_sqlite", "label": "SQLite", "file_type": "concept", "source_file": "README.md", "source_location": "L9, L34, L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_unified_titlebar", "label": "Unified toolbar and titlebar", "file_type": "rationale", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Daily navigation and date sit beside minimize, maximize/restore and close controls in one application toolbar; blank areas drag the window and double-click toggles maximization."}, {"id": "readme_mini_calendar_picker", "label": "Mini-Kalender date picker", "file_type": "concept", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Clicking the date or pressing Ctrl+G opens the application's compact calendar instead of the native Windows date picker."}, {"id": "readme_ics_exchange", "label": "ICS import and export", "file_type": "concept", "source_file": "README.md", "source_location": "L9\u2013L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_export_scope", "label": "Calendar export boundary", "file_type": "rationale", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Export includes tasks and events from every day, including calendar-only entries. It excludes free text, daily titles, notes and planning traces. Tasks are represented as events with additional Journal type information."}, {"id": "readme_calendar_uid", "label": "Calendar UID identity", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Matching calendar UIDs update existing occurrences rather than creating duplicate entries."}, {"id": "readme_atomic_calendar_import", "label": "Atomic calendar import", "file_type": "rationale", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Import runs as one transaction, shows a preview and preserves unrelated entries and daily contents."}, {"id": "readme_import_conversion_limits", "label": "Calendar import conversion limits", "file_type": "rationale", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Recurring events are expanded from the previous year through the end of the second following year. Multi-day events become daily entries. Export does not reconstruct recurrence rules. Imports are limited to 5 MB and 5000 entries, do not delete removed occurrences automatically, and do not move entries already planned onward."}, {"id": "readme_calendar_timezones", "label": "Calendar timezone interpretation", "file_type": "rationale", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Import supports all-day and timed events, dated tasks, UTC, local time, IANA timezones and embedded timezone definitions."}, {"id": "readme_calendar_only", "label": "Nur im Kalender entry choice", "file_type": "concept", "source_file": "README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Calendar-only is a peer choice beside event and task. These entries remain editable, stored and exportable but do not appear in the daily note. Changing the choice back to event or task restores daily-note visibility."}, {"id": "readme_daily_notes", "label": "Daily notes", "file_type": "concept", "source_file": "README.md", "source_location": "L13, L17\u2013L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_task_status_rendering", "label": "Calendar task status rendering", "file_type": "rationale", "source_file": "README.md", "source_location": "L13, L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Completed tasks are greyed out. Cancelled tasks are greyed out and struck through; completion alone does not add strikethrough."}, {"id": "readme_autosave", "label": "Debounced autosave at 0.7 seconds", "file_type": "rationale", "source_file": "README.md", "source_location": "L18, L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Daily notes save after a 0.7-second typing pause; Ctrl+S saves immediately. Pending changes are saved before navigation or closing. Failed saves prevent navigation or request explicit confirmation before closing."}, {"id": "readme_action_layouts", "label": "Orbit inline and swipe actions", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_localstorage", "label": "localStorage", "file_type": "concept", "source_file": "README.md", "source_location": "L18, L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Action layout and sidebar width are device-local preferences rather than journal database content."}, {"id": "readme_planning", "label": "Linked multi-day planning", "file_type": "rationale", "source_file": "README.md", "source_location": "L20\u2013L25, L31, L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Planning to other dates creates target entries once and leaves a trace. Text, kind and priority propagate through linked groups; status and time remain occurrence-specific. Group actions can target this occurrence, following occurrences or all linked entries."}, {"id": "readme_calendar", "label": "Kalender in der Seitenleiste", "file_type": "concept", "source_file": "README.md", "source_location": "L27, L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Year, month, week, workweek and day views follow the journal date. The sidebar width is at least 280 pixels and leaves at least 420 pixels for the journal."}, {"id": "readme_notifications", "label": "Reminders without notifications", "file_type": "rationale", "source_file": "README.md", "source_location": "L20, L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The reminder preference is stored and displayed as a bell, but notifications are not implemented."}, {"id": "readme_codemirror", "label": "CodeMirror-6", "file_type": "concept", "source_file": "README.md", "source_location": "L43, L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Each entry uses a live-preview editor. Formatting markers are visible only around the cursor or selection, while storage retains complete Markdown text. Code, links and formulas are intentionally unsupported."}, {"id": "readme_main_tsx", "label": "src/main.tsx application window", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_journal_ts", "label": "src/journal.ts backend connection", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_storage_rs", "label": "src-tauri/src/storage.rs persistence", "file_type": "concept", "source_file": "README.md", "source_location": "L76\u2013L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The storage module manages validation, database migrations and SQLite transactions."}, {"id": "readme_load_range", "label": "load_range calendar reads", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_journal_changed", "label": "journal:changed event", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The calendar learns which days were saved through the journal:changed Tauri event."}, {"id": "readme_revision", "label": "Revision prevents stale writes", "file_type": "rationale", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "A revision prevents an older day snapshot from overwriting newer stored content. This does not constitute a synchronization conflict strategy."}, {"id": "readme_local_date", "label": "Local calendar dates", "file_type": "rationale", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Days are identified by local calendar date rather than UTC timestamps; new entries receive UUIDs."}, {"id": "readme_touched", "label": "Touched-day cache invalidation", "file_type": "rationale", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Save responses report affected days in touched so the frontend can discard cached states after linked planning changes."}, {"id": "readme_sync", "label": "Synchronization not implemented", "file_type": "rationale", "source_file": "README.md", "source_location": "L11, L35, L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "ICS import is not synchronization. Full journal backups and automatic synchronization are not implemented; synchronization would need explicit deletion, version and conflict modeling."}, {"id": "readme_test_ui", "label": "check:ui", "file_type": "concept", "source_file": "README.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The Edge UI check uses official Tauri IPC mocks and synthetic in-memory data without opening the real SQLite database. It does not replace manual native-window or installer tests."}, {"id": "readme_wal", "label": "WAL-Modus", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "readme_inline", "label": "Eingebettet", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The inline action layout displays actions as words within the text flow without a separate window, background or shadow."}, {"id": "readme_offline_fonts", "label": "@fontsource", "file_type": "concept", "source_file": "README.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Lilex and IBM Plex Sans are bundled through @fontsource under OFL-1.1 and work offline without separately installed fonts."}, {"id": "readme_orbit", "label": "Satelliten", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The orbit action layout places round animated action satellites around the entry symbol while keeping the text unobstructed."}, {"id": "readme_swipe", "label": "Wischen", "file_type": "concept", "source_file": "README.md", "source_location": "L18, L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "The swipe action layout maps directional gestures on an entry symbol to planning, deletion, status and priority actions; the chosen layout is stored locally."}, {"id": "readme_test_js", "label": "npm.cmd test", "file_type": "concept", "source_file": "README.md", "source_location": "L60, L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "npm.cmd test covers entry grouping, priority ordering, reordering, planning, calendars, clock input and Markdown behavior."}, {"id": "readme_test_rust", "label": "Rust-Tests", "file_type": "concept", "source_file": "README.md", "source_location": "L60, L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Rust database tests cover persistence, validation, migrations, stale writes, entry status, linked planning and reopening database files. The README test count is historical, not a current measured result."}, {"id": "readme_transaction", "label": "Atomic SQLite day transaction", "file_type": "concept", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic", "rationale": "Saving replaces the entries of one day inside a SQLite transaction, creates previously absent planning targets and updates the revisions of affected days."}], "edges": [{"source": "readme_journal", "target": "readme_tauri", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0, "_origin": "semantic"}, {"source": "readme_journal", "target": "readme_react", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0, "_origin": "semantic"}, {"source": "readme_journal", "target": "readme_typescript", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0, "_origin": "semantic"}, {"source": "readme_journal", "target": "readme_sqlite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3, L9", "weight": 1.0, "_origin": "semantic"}, {"source": "readme_journal", "target": "readme_unified_titlebar", "relation": 