{
  "name": "journal-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:ui": "node scripts/verify-ui.mjs",
    "test": "node --test tests/*.test.mjs",
    "train:mail-context": "node scripts/train-mail-context.mjs",
    "check:mail-context": "node scripts/evaluate-mail-context.mjs",
    "tauri": "tauri",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lilex": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "chrono-node": "^2.10.3",
    "ical.js": "^2.2.1",
    "lucide": "^1.71.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
